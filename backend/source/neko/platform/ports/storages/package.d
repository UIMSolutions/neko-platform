/// Driven ports for low-level data stores: named collections of JSON
/// documents, and blobs (file content) in folders.
module neko.platform.ports.storages;

import vibe.data.json : Json;

@safe:

interface IDocumentStore {
  /// All documents of a collection, keyed by id (empty if the collection is new).
  Json[string] load(string collection);
  /// Replace the whole collection atomically.
  void store(string collection, Json[string] documents);
  /// Human-readable description for diagnostics ("memory", "file:data/open").
  string describe();
}

/// What a blob store reports about stored content.
struct BlobInfo {
  long size;
  /// Hex SHA-256.
  string sha256;
}

/// File content, kept per folder (one folder per subaccount). Ids are generated by
/// the platform, never taken from a client.
interface IBlobStore {
  /// Store the content of the local file `source` (an upload's temporary
  /// file; it may be moved).
  BlobInfo putFile(string folder, string id, string source);
  BlobInfo put(string folder, string id, const(ubyte)[] data);
  /// Path on the local file system, so the HTTP layer can stream it (with
  /// range requests); "" if the store keeps blobs elsewhere — then use `get`.
  string localPath(string folder, string id);
  ubyte[] get(string folder, string id);
  bool remove(string folder, string id);
  /// Bytes stored in `folder`.
  long usage(string folder);
  /// Free bytes on the underlying volume; -1 if unknown.
  long available();
  string describe();
}
