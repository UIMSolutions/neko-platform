//- Password change form (htmx replaces it with the answer). Needs page, message, error.
- import neko.platform.presentation.web.icons : icon;
.card#password-form
  .card-header
    h3.card-title Change password
  form(hx-post="/account/password", hx-target="#password-form", hx-swap="outerHTML")
    .card-body
      - if (message.length)
        .alert.alert-success(role="status")
          .d-flex.gap-2
            | !{icon("circle-check")}
            div= message
      - if (error.length)
        .alert.alert-danger(role="alert")
          .d-flex.gap-2
            | !{icon("alert-circle")}
            div= error
      .mb-3
        label.form-label.required(for="pw-current") Current password
        input#pw-current.form-control(type="password", name="current", required=true, autocomplete="current-password")
      .mb-3
        label.form-label.required(for="pw-new") New password
        input#pw-new.form-control(type="password", name="password", required=true, minlength="10", autocomplete="new-password")
        .form-hint At least 10 characters
      .mb-3
        label.form-label.required(for="pw-confirm") Repeat new password
        input#pw-confirm.form-control(type="password", name="confirm", required=true, minlength="10", autocomplete="new-password")
    .card-footer.text-end
      button.btn.btn-primary(type="submit")
        | !{icon("key")}
        | Change password
