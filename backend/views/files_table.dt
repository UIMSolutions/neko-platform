//- The file table; swapped as a whole after every change. Needs page, view (FileView), list (FileDto[]).
- import neko.platform.application.dtos : byteSize;
- import neko.platform.presentation.web.icons : icon;
- import neko.platform.presentation.web.support : shortTime;
- import vibe.data.json : Json;
- auto kindVals = Json(["kind": Json(view.kind)]).toString;
- string kindIcon(string k) { switch (k) { case "image": return "photo"; case "video": return "movie"; case "audio": return "music"; case "document": return "file-text"; case "archive": return "file-zip"; default: return "file"; } }
.card#files-table
  - if (view.error.length)
    .card-body
      .alert.alert-danger.mb-0= view.error
  - else if (list.length == 0)
    .card-body
      .empty
        .empty-icon
          | !{icon("folder")}
        p.empty-title No files
        p.empty-subtitle.text-secondary #{view.kind.length ? "No files of this kind." : "Upload documents, images, audio or video above."}
  - else
    .table-responsive
      table.table.table-vcenter.card-table
        thead
          tr
            th File
            th.text-end Size
            th Visibility
            th.text-nowrap Uploaded (UTC)
            th.w-1
        tbody
          - foreach (f; list)
            tr
              td
                .d-flex.align-items-center.gap-2
                  - if (f.kind == "image" && f.inline)
                    img.avatar.avatar-md.file-thumb(src="/files/#{f.id}/view", alt=f.description, loading="lazy")
                  - else
                    span.avatar.avatar-md(class=(f.kind == "video" ? "bg-purple-lt" : f.kind == "audio" ? "bg-pink-lt" : f.kind == "document" ? "bg-azure-lt" : "bg-secondary-lt"))
                      | !{icon(kindIcon(f.kind))}
                  div.text-truncate
                    .fw-bold.text-truncate= f.name
                    .text-secondary.small.text-truncate
                      | #{f.kind} · #{f.contentType}
                      - if (f.description.length)
                        |  · #{f.description}
              td.text-end.text-nowrap= byteSize(f.size)
              td
                - if (f.isPublic)
                  a.badge.bg-green-lt(href=f.publicUrl, target="_blank", rel="noopener", title="Public address")
                    | !{icon("eye")}
                    | public
                - else
                  span.badge.bg-secondary-lt
                    | !{icon("eye-off")}
                    | private
              td.text-nowrap.text-secondary
                div= shortTime(f.createdAt)
                .small= f.uploadedBy
              td.text-nowrap
                .d-flex.gap-1.justify-content-end
                  - if (f.inline)
                    a.btn.btn-ghost-secondary.btn-icon(href="/files/#{f.id}/view", target="_blank", rel="noopener", title="Open", aria-label="Open #{f.name}")
                      | !{icon("external-link")}
                  a.btn.btn-ghost-secondary.btn-icon(href="/files/#{f.id}/download", title="Download", aria-label="Download #{f.name}")
                    | !{icon("download")}
                  - if (page.isFilesManage)
                    button.btn.btn-ghost-secondary.btn-icon(hx-get="/files/#{f.id}/edit", hx-target="#dialog-host", title="Edit", aria-label="Edit #{f.name}")
                      | !{icon("pencil")}
                    button.btn.btn-ghost-danger.btn-icon(hx-post="/files/#{f.id}/delete", hx-vals=kindVals, hx-target="#files-table", hx-swap="outerHTML", hx-confirm="Remove #{f.name}? This cannot be undone.", title="Remove", aria-label="Remove #{f.name}")
                      | !{icon("trash")}
