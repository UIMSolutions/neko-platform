//- Reset-password dialog. Needs page, user (UserDto), error.
- import neko.platform.presentation.web.icons : icon;
.modal.modal-blur.fade(tabindex="-1", aria-labelledby="dialog-title", aria-modal="true", role="dialog")
  .modal-dialog.modal-dialog-centered.modal-sm
    .modal-content
      form(hx-post="/users/#{user.id}/password", hx-target="closest .modal-content", hx-select=".modal-content", hx-swap="outerHTML")
        .modal-header
          h5#dialog-title.modal-title Reset password of #{user.userName}
          button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body
          p.text-secondary The user is signed out everywhere and signs in with the new password.
          - if (error.length)
            .alert.alert-danger(role="alert")
              .d-flex.gap-2
                | !{icon("alert-circle")}
                div= error
          .mb-3
            label.form-label.required(for="r-pw") New password
            input#r-pw.form-control(type="password", name="password", required=true, minlength="10", autocomplete="new-password")
            .form-hint At least 10 characters
          .mb-3
            label.form-label.required(for="r-pw2") Repeat password
            input#r-pw2.form-control(type="password", name="confirm", required=true, minlength="10", autocomplete="new-password")
        .modal-footer
          button.btn.me-auto(type="button", data-bs-dismiss="modal") Cancel
          button.btn.btn-primary(type="submit")
            | !{icon("key")}
            | Reset password
