//- Reset-password dialog. Needs page, user (UserDto), error.
dialog
  h5 Reset password of #{user.userName}
  p.small-text The user is signed out everywhere and signs in with the new password.
  - if (error.length)
    article.error-container.round.small-padding(role="alert")
      nav
        i error
        span= error
  form(hx-post="/users/#{user.id}/password", hx-target="#dialog-host")
    .field.label.border
      input(type="password", name="password", required=true, minlength="10", autocomplete="new-password", placeholder=" ")
      label New password
      span.helper At least 10 characters
    .field.label.border
      input(type="password", name="confirm", required=true, minlength="10", autocomplete="new-password", placeholder=" ")
      label Repeat password
    nav.right-align
      button.border(type="button", data-close-dialog=true) Cancel
      button(type="submit")
        i key
        span Reset password
