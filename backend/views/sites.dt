extends layout
//- Sites (tenants). Needs page, list (SiteDto[]).
block actions
  - import neko.platform.presentation.web.icons : icon;
  - if (page.isSitesManage && page.user.allSites)
    button.btn.btn-primary(hx-get="/sites/new", hx-target="#dialog-host")
      | !{icon("plus")}
      | New site
block content
  p.text-secondary Each site is a tenant with its own host names, languages, home page and file library. A request is answered by the site that claims its host name; all others get the default site at /. Accounts can be limited to some sites (Users).
  include sites_table
