doctype html
html(lang="en", data-theme="corporate")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{title} · #{info.domain}
    //- daisyUI class names; the styles below are a self-contained fallback,
    //- because isolated domains cannot load a CDN. Drop a self-hosted daisyUI
    //- build into frontend/css/daisyui.css to use the full theme.
    link(rel="stylesheet", href="/css/daisyui.css")
    style.
      :root { --b1:#fff; --b2:#f3f5f7; --bc:#1d2d3e; --p:#0a6ed1; --su:#107e3e; --er:#bb0000; --wa:#e9730c; }
      @media (prefers-color-scheme: dark) { :root { --b1:#1d232a; --b2:#29323c; --bc:#e5e9ee; } }
      body { margin:0; font-family: "72", system-ui, sans-serif; background:var(--b2); color:var(--bc); }
      .navbar { display:flex; justify-content:space-between; align-items:center; padding:12px 24px; background:var(--b1); border-bottom:1px solid #0001; }
      .container { max-width:1100px; margin:0 auto; padding:16px; }
      .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin:16px 0; }
      .stat, .card { background:var(--b1); border-radius:12px; padding:16px; box-shadow:0 1px 2px #0002; }
      .stat-title { font-size:.8rem; opacity:.7; } .stat-value { font-size:1.8rem; font-weight:700; }
      .card { margin-bottom:16px; overflow-x:auto; } .card-title { margin:0 0 12px; font-size:1.1rem; }
      .table { width:100%; border-collapse:collapse; font-size:.9rem; }
      .table th, .table td { text-align:left; padding:8px; border-bottom:1px solid #0001; }
      .badge { display:inline-block; padding:2px 10px; border-radius:999px; font-size:.75rem; border:1px solid currentColor; }
      .badge-success { color:var(--su); } .badge-error { color:var(--er); } .badge-warning { color:var(--wa); } .badge-primary { color:var(--p); }
      a { color:var(--p); }
  body
    .navbar
      span.text-xl
        strong= title
      span.badge.badge-primary= info.domain
    .container
      .stats
        .stat
          .stat-title Services
          .stat-value= info.serviceCount
        .stat
          .stat-title Active
          .stat-value= info.activeServices
        .stat
          .stat-title Down
          .stat-value= info.servicesDown
        .stat
          .stat-title Transfers
          .stat-value= info.transferCount
        .stat
          .stat-title Rejected
          .stat-value= info.rejectedTransfers
      .card
        h2.card-title Capabilities
        p
          | Export:
          - if (info.canExport)
            span.badge.badge-success to #{info.exportTargets.length ? info.exportTargets[0] : ""}#{info.exportTargets.length > 1 ? " …" : ""}
          - else
            span.badge.badge-error disabled
          | &nbsp; Import:
          - if (info.canImport)
            span.badge.badge-success enabled
          - else
            span.badge.badge-error disabled
          | &nbsp; Environment: #{info.environment}
        p
          a(href="/index.html") Open the Fiori cockpit
          | &nbsp;·&nbsp;
          a(href="/odata/v4/platform/$metadata") OData $metadata
          | &nbsp;·&nbsp;
          a(href="/api/v1/info") Configuration
      .card
        h2.card-title Service catalogue
        - if (catalogue.length == 0)
          p No services registered yet.
        - else
          table.table
            thead
              tr
                th Name
                th Classification
                th Status
                th Health
                th Base URL
            tbody
              - foreach (s; catalogue)
                tr
                  td
                    strong= s.name
                    br
                    small= s.description
                  td= s.classification
                  td
                    - auto statusClass = s.status == "active" ? "badge-success" : s.status == "retired" ? "badge-error" : "badge-warning";
                    span.badge(class=statusClass)= s.status
                  td
                    - auto healthClass = s.health == "up" ? "badge-success" : s.health == "down" ? "badge-error" : "";
                    span.badge(class=healthClass)= s.health
                  td= s.baseUrl
      .card
        h2.card-title Recent events
        - if (recent.length == 0)
          p No events since the last start.
        - else
          table.table
            thead
              tr
                th Time
                th Event
                th Actor
                th Message
            tbody
              - foreach (e; recent)
                tr
                  td= e.at.toISOExtString
                  td= e.type
                  td= e.actor
                  td= e.message
