//- Live part of the status page; replaces itself every 30 seconds (htmx).
- import std.conv : to;
- import neko.platform.application.dtos : isoTime;
- import neko.platform.domain.enumerations.rights : AccessRight;
- import neko.platform.presentation.web.icons : icon;
#live(hx-get="/status/live", hx-trigger="every 30s", hx-swap="outerHTML")
  .row.row-deck.row-cards
    - foreach (t; [["Services", info.serviceCount.to!string, "apps", "primary"], ["Active", info.activeServices.to!string, "player-play", "green"], ["Down", info.servicesDown.to!string, "alert-triangle", info.servicesDown > 0 ? "red" : "secondary"], ["Transfers", info.transferCount.to!string, "arrows-exchange", "azure"], ["Rejected", info.rejectedTransfers.to!string, "ban", info.rejectedTransfers > 0 ? "orange" : "secondary"]])
      .col-6.col-md-4.col-xl
        .card.card-sm
          .card-body
            .row.align-items-center
              .col-auto
                span.avatar(class="bg-" ~ t[3] ~ "-lt")
                  | !{icon(t[2])}
              .col
                .h2.mb-0= t[1]
                .text-secondary= t[0]

    .col-12
      .card
        .card-header
          h3.card-title Capabilities
        .card-body
          .d-flex.flex-wrap.gap-2.mb-3
            - if (info.canExport)
              span.badge.bg-green-lt.badge-lg
                | !{icon("upload")}
                | Export to #{info.exportTargets.length ? info.exportTargets[0] : ""}#{info.exportTargets.length > 1 ? " …" : ""}
            - else
              span.badge.bg-secondary-lt.badge-lg
                | !{icon("ban")}
                | Export disabled
            - if (info.canImport)
              span.badge.bg-green-lt.badge-lg
                | !{icon("download")}
                | Import enabled
            - else
              span.badge.bg-secondary-lt.badge-lg
                | !{icon("ban")}
                | Import disabled
            span.badge.bg-secondary-lt.badge-lg
              | !{icon("server")}
              | Environment: #{info.environment}
          .btn-list
            a.btn.btn-sm(href="/index.html")
              | !{icon("layout-dashboard")}
              | Fiori cockpit
            a.btn.btn-sm(href="/odata/v4/platform/$metadata")
              | !{icon("code")}
              | OData $metadata
            a.btn.btn-sm(href="/api/v1/info")
              | !{icon("settings")}
              | Configuration

    .col-12
      .card
        .card-header
          h3.card-title Service catalogue
        - if (catalogue.length == 0)
          .card-body
            p.text-secondary.mb-0 No services registered yet.
        - else
          .table-responsive
            table.table.table-vcenter.card-table
              thead
                tr
                  th Name
                  th Classification
                  th Status
                  th Health
                  th Base URL
              tbody
                - foreach (s; catalogue)
                  tr
                    td
                      .fw-bold= s.name
                      .text-secondary.small= s.description
                    td= s.classification
                    td
                      - auto statusColor = s.status == "active" ? "green" : s.status == "retired" ? "red" : "orange";
                      span.badge(class="bg-" ~ statusColor ~ "-lt")= s.status
                    td
                      - auto healthColor = s.health == "up" ? "green" : s.health == "down" ? "red" : "secondary";
                      span.status(class="status-" ~ healthColor)
                        span.status-dot
                        | #{s.health}
                    td.text-secondary= s.baseUrl

    - if (page.can(AccessRight.eventsRead))
      .col-12
        .card
          .card-header
            h3.card-title Recent events
          - if (recent.length == 0)
            .card-body
              p.text-secondary.mb-0 No events since the last start.
          - else
            .table-responsive
              table.table.table-vcenter.card-table.table-sm
                thead
                  tr
                    th.text-nowrap Time (UTC)
                    th Event
                    th Actor
                    th Message
                tbody
                  - foreach (e; recent)
                    tr
                      - auto when = isoTime(e.at);
                      td.text-nowrap.text-secondary= when.length >= 19 ? when[0 .. 10] ~ " " ~ when[11 .. 19] : when
                      td
                        code= e.type
                      td= e.actor
                      td= e.message
