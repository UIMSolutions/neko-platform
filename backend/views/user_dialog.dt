//- Create / edit dialog (htmx fragment for #dialog-host). Needs page, form (UserForm), roleList (RoleDto[]).
//- Roles with rights the signed-in user does not hold cannot be handed out (greyed out).
- import neko.platform.presentation.web.icons : icon;
- import neko.platform.presentation.web.support : mayAssign;
.modal.modal-blur.fade(tabindex="-1", aria-labelledby="dialog-title", aria-modal="true", role="dialog")
  .modal-dialog.modal-dialog-centered
    .modal-content
      form(hx-post=(form.isNew ? "/users" : "/users/" ~ form.id), hx-target="closest .modal-content", hx-select=".modal-content", hx-swap="outerHTML")
        .modal-header
          h5#dialog-title.modal-title= form.isNew ? "New user" : "Edit " ~ form.userName
          button.btn-close(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body
          - if (form.error.length)
            .alert.alert-danger(role="alert")
              .d-flex.gap-2
                | !{icon("alert-circle")}
                div= form.error
          - if (form.isNew)
            .mb-3
              label.form-label.required(for="u-name") User name
              input#u-name.form-control(type="text", name="userName", value=form.userName, required=true, minlength="2", maxlength="64", autocomplete="off", autocapitalize="none", spellcheck="false")
              .form-hint a-z, 0-9, . _ - @
          .row
            .col-md-6.mb-3
              label.form-label(for="u-display") Display name
              input#u-display.form-control(type="text", name="displayName", value=form.displayName, maxlength="128")
            .col-md-6.mb-3
              label.form-label(for="u-email") E-mail
              input#u-email.form-control(type="email", name="email", value=form.email)
          - if (form.self)
            .alert.alert-info.mb-3
              .d-flex.gap-2
                | !{icon("info-circle")}
                div You cannot change the roles or the status of your own account.
          - else
            .mb-3
              .form-label Roles
              .form-selectgroup.form-selectgroup-boxes.d-flex.flex-column
                - foreach (r; roleList)
                  - auto allowed = mayAssign(page.user, r);
                  label.form-selectgroup-item.flex-fill(title=(allowed ? "" : "Grants rights you do not hold"))
                    input.form-selectgroup-input(type="checkbox", name="roles", value=r.name, checked=form.hasRole(r.name), disabled=!allowed)
                    .form-selectgroup-label.d-flex.align-items-center.p-2(class=(allowed ? "" : "opacity-50"))
                      .me-2
                        span.form-selectgroup-check
                      div
                        .fw-medium #{r.label} 
                          code.small.ms-1= r.name
                        .small.text-secondary= r.description
              .form-hint Rights add up: a user holds every right of each of its roles.
            .form-hint.mb-3 Which subaccounts' files the user reaches follows the user groups of the subaccounts (Landscape → subaccount → Access); a user in no user group reaches every subaccount.
            label.form-check.form-switch
              input.form-check-input(type="checkbox", name="active", checked=form.active)
              span.form-check-label Active (may sign in)
          - if (form.isNew)
            .row.mt-3
              .col-md-6.mb-3
                label.form-label.required(for="u-pw") Password
                input#u-pw.form-control(type="password", name="password", required=true, minlength="10", autocomplete="new-password")
                .form-hint At least 10 characters
              .col-md-6.mb-3
                label.form-label.required(for="u-pw2") Repeat password
                input#u-pw2.form-control(type="password", name="confirm", required=true, minlength="10", autocomplete="new-password")
        .modal-footer
          button.btn.me-auto(type="button", data-bs-dismiss="modal") Cancel
          button.btn.btn-primary(type="submit")
            | !{icon("check")}
            | #{form.isNew ? "Create" : "Save"}
