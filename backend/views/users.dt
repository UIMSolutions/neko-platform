extends layout
//- User management. Needs page, list (UserDto[]).
block content
  nav
    h5.max Users
    button(hx-get="/users/new", hx-target="#dialog-host")
      i person_add
      span New user
  p.small-text Viewers see the status pages. Administrators also manage users. Accounts belong to this #{page.domain} instance only.
  include users_table
