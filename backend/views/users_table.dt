//- The user table; swapped as a whole after every change. Needs page, list, roleList.
- import neko.platform.presentation.web.icons : icon;
- import neko.platform.presentation.web.support : initial, shortTime;
- string roleLabel(string name) { foreach (r; roleList) if (r.name == name) return r.label; return name ~ " (removed)"; }
.card#users-table
  .table-responsive
    table.table.table-vcenter.card-table
      thead
        tr
          th User
          th E-mail
          th Roles
          th Status
          th.text-nowrap Last sign-in (UTC)
          - if (page.isUsersManage)
            th.w-1
      tbody
        - foreach (u; list)
          - auto self = u.id == page.user.id;
          tr
            td
              .d-flex.align-items-center
                span.avatar.avatar-sm.me-2= initial(u.label)
                div
                  .fw-bold
                    | #{u.userName}
                    - if (self)
                      span.text-secondary.fw-normal.ms-1 (you)
                  .text-secondary.small= u.displayName
            td.text-secondary= u.email
            td
              - foreach (r; u.roles)
                span.badge.me-1(class=(r == "admin" ? "bg-primary text-primary-fg" : "bg-primary-lt"), title=r)= roleLabel(r)
            td
              - if (u.active)
                span.badge.bg-green-lt active
              - else
                span.badge.bg-red-lt inactive
            td.text-nowrap.text-secondary= shortTime(u.lastLoginAt, "never")
            - if (page.isUsersManage)
              td.text-nowrap
                .d-flex.gap-1.justify-content-end
                  button.btn.btn-ghost-secondary.btn-icon(hx-get="/users/#{u.id}/edit", hx-target="#dialog-host", title="Edit", aria-label="Edit #{u.userName}")
                    | !{icon("pencil")}
                  - if (!self)
                    button.btn.btn-ghost-secondary.btn-icon(hx-get="/users/#{u.id}/password", hx-target="#dialog-host", title="Reset password", aria-label="Reset password of #{u.userName}")
                      | !{icon("key")}
                    button.btn.btn-ghost-danger.btn-icon(hx-post="/users/#{u.id}/delete", hx-target="#users-table", hx-swap="outerHTML", hx-confirm="Remove user #{u.userName}? This cannot be undone.", title="Remove", aria-label="Remove #{u.userName}")
                      | !{icon("trash")}