//- The user table; swapped as a whole after every change. Needs page, list.
article#users-table.round
  .scroll
    table.stripes
      thead
        tr
          th User
          th Name
          th E-mail
          th Role
          th Status
          th.nowrap Last sign-in (UTC)
          th
      tbody
        - foreach (u; list)
          - auto self = u.id == page.user.id;
          tr
            td
              strong= u.userName
              - if (self)
                span.small-text.small-margin (you)
            td= u.displayName
            td= u.email
            td
              - if (u.isAdmin)
                span.chip.small.primary
                  i shield_person
                  span admin
              - else
                span.chip.small.border viewer
            td
              - if (u.active)
                span.chip.small.green-border.green-text active
              - else
                span.chip.small.red-border.red-text inactive
            td.nowrap
              - auto last = u.lastLoginAt;
              | #{last.length >= 16 ? last[0 .. 10] ~ " " ~ last[11 .. 16] : "never"}
            td.actions
              button.circle.transparent(hx-get="/users/#{u.id}/edit", hx-target="#dialog-host", title="Edit", aria-label="Edit #{u.userName}")
                i edit
              - if (!self)
                button.circle.transparent(hx-get="/users/#{u.id}/password", hx-target="#dialog-host", title="Reset password", aria-label="Reset password of #{u.userName}")
                  i key
                button.circle.transparent(hx-post="/users/#{u.id}/delete", hx-target="#users-table", hx-swap="outerHTML", hx-confirm="Remove user #{u.userName}? This cannot be undone.", title="Remove", aria-label="Remove #{u.userName}")
                  i delete
