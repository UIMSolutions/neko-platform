name "neko-platform"
description "Multi-client service platform with security domains (open, restricted, confidential, secret)"
license "Apache-2.0"
dependency "vibe-d" version="~>0.10.5"
dependency "dyaml" version="~>0.10.0"
dependency "uim-framework" version="~>26.11.1"
targetType "executable"
targetPath "build"
targetName "neko_platform"
authors "Ozan Nurettin Süel"
copyright "Ozan Nurettin Süel"
copyrightYear 2026

mainSourceFile "backend/source/app.d"
sourcePaths "backend/source"
importPaths "backend/source"
stringImportPaths "backend/views" "backend/assets"

// dependency ":authentication" version="*"
// dependency ":authorization" version="*"
// dependency ":connectivity" version="*"
// dependency ":database" version="*"
// dependency ":management" version="*"
// dependency ":objects" version="*"
// dependency ":provisioning" version="*"

// subPackage "services/authentication/backend"
// subPackage "services/authorization/backend"
// subPackage "services/connectivity/backend"
// subPackage "services/database/backend"
// subPackage "services/management/backend"
// subPackage "services/objects/backend"
// subPackage "services/provisioning/backend"

configuration "open" {
	targetType "executable"
	targetName "platform-open"
	versions "DomainOpen"
}
configuration "restricted" {
	targetType "executable"
	targetName "platform-restricted"
	versions "DomainRestricted"
}
configuration "confidential" {
	targetType "executable"
	targetName "platform-confidential"
	versions "DomainConfidential"
}
configuration "secret" {
	targetType "executable"
	targetName "platform-secret"
	versions "DomainSecret"
}
