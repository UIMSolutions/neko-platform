<mvc:View
  controllerName="neko.platform.controller.ServiceDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns="sap.m">
  <Page id="servicePage" title="{Name}" showNavButton="true" navButtonPress=".onNavBack" showFooter="true">
    <content>
      <ObjectHeader
        title="{Name}"
        intro="{Description}"
        icon="sap-icon://cloud"
        responsive="true"
        backgroundDesign="Translucent">
        <statuses>
          <ObjectStatus title="{i18n>services.status}"
            text="{path: 'Status', formatter: '.formatter.serviceStatusText'}"
            state="{path: 'Status', formatter: '.formatter.serviceStatusState'}"/>
          <ObjectStatus title="{i18n>services.health}"
            text="{path: 'Health', formatter: '.formatter.healthText'}"
            icon="{path: 'Health', formatter: '.formatter.healthIcon'}"
            state="{path: 'Health', formatter: '.formatter.healthState'}"/>
        </statuses>
        <attributes>
          <ObjectAttribute title="{i18n>services.classification}"
            text="{path: 'Classification', formatter: '.formatter.domainText'}"/>
          <ObjectAttribute title="{i18n>services.lastChecked}" text="{LastCheckedAt}"/>
          <ObjectAttribute title="ID" text="{ID}"/>
        </attributes>
      </ObjectHeader>

      <form:SimpleForm
        id="serviceForm"
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanL="3" labelSpanM="3" emptySpanL="4" emptySpanM="2"
        title="{i18n>services.details}">
        <form:content>
          <Label text="{i18n>services.description}"/>
          <Input id="descriptionInput" value="{Description}" editable="{= ${ui>/editMode} &amp;&amp; %{Status} !== 'retired' }"/>
          <Label text="{i18n>services.baseUrl}"/>
          <Input id="baseUrlInput" value="{BaseUrl}" placeholder="https://service.example"
            editable="{= ${ui>/editMode} &amp;&amp; %{Status} !== 'retired' }"/>
          <Label text="{i18n>services.healthPath}"/>
          <Input id="healthPathInput" value="{HealthPath}" placeholder="/health"
            editable="{= ${ui>/editMode} &amp;&amp; %{Status} !== 'retired' }"/>
          <Label text="{i18n>services.created}"/>
          <Text text="{CreatedAt}"/>
          <Label text="{i18n>services.modified}"/>
          <Text text="{ModifiedAt}"/>
        </form:content>
      </form:SimpleForm>
    </content>
    <footer>
      <OverflowToolbar>
        <ToggleButton id="editButton" text="{= ${ui>/editMode} ? ${i18n>done} : ${i18n>edit} }"
          icon="sap-icon://edit" pressed="{ui>/editMode}" enabled="{= %{Status} !== 'retired' }"/>
        <ToolbarSpacer/>
        <Button id="activateButton" text="{i18n>action.activate}" type="Accept"
          enabled="{= %{Status} === 'registered' || %{Status} === 'suspended' }" press=".onActivate"/>
        <Button id="suspendButton" text="{i18n>action.suspend}"
          enabled="{= %{Status} === 'active' }" press=".onSuspend"/>
        <Button id="checkButton" text="{i18n>action.check}" icon="sap-icon://stethoscope"
          enabled="{= %{Status} === 'active' &amp;&amp; !!%{BaseUrl} }" press=".onCheckHealth"/>
        <Button id="retireButton" text="{i18n>action.retire}" type="Reject"
          enabled="{= %{Status} !== 'retired' }" press=".onRetire"/>
        <Button id="deleteButton" text="{i18n>action.delete}" icon="sap-icon://delete" type="Reject"
          visible="{= %{Status} === 'retired' }" press=".onDelete"/>
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
