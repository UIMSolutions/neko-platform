name "authorization"
description "Identity Authorization Service — applications, policies, assignments and runtime authorization decisions."
homepage "https://github.com/UIMSolutions/neko-services-platform"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"
dependency "vibe-d" version="~>0.10.5"
dependency "neko-service-platform:service" path=".."
dependency "uim-framework" version="~>26.11.1"
targetPath "build"
sourcePaths "backend/source"
importPaths "backend/source"
stringImportPaths "views"

// Shared platform library: uim-framework, vibe-d 0.10.x, generic OData v4 engine,
// CLI toolkit and GtkD entity browser.
dependency "neko-services-platform:service" path=".."

buildRequirements "allowWarnings" "silenceDeprecations"

// ── HTTP server: JSON API (/api/v1), REST (/rest/v1/authorization), OData v4
//    (/odata/v4/authorization), dashboard (/web) and Fiori app (/app)
// dub build            (or --config=defaultRun)
// ./build/uim-authorization-platform-service
configuration "defaultRun" {
	targetType "executable"
	targetName "neko-service-authorization"
	mainSourceFile "backend/source/app.d"
	excludedSourceFiles "backend/source/cli.d" "backend/source/gui.d"
}

// ── Command line interface ──────────────────────────────────────────────────
// dub build --config=cli
// ./build/uim-authorization-cli help
configuration "cli" {
	targetType "executable"
	targetName "neko-service-authorization-cli"
	mainSourceFile "backend/source/cli.d"
	excludedSourceFiles "backend/source/app.d" "backend/source/gui.d"
}

// ── Desktop GUI (GtkD 3 / GTK 3.24) ─────────────────────────────────────────
// dub build --config=gui
// ./build/uim-authorization-gui [--tenant=<id>] [--data-file=<path>] [--refresh=<seconds>]
configuration "gui" {
	targetType "executable"
	targetName "neko-service-authorization-gui"
	mainSourceFile "backend/source/gui.d"
	excludedSourceFiles "backend/source/app.d" "backend/source/cli.d"
	dependency "gtk-d" version="~>3.11.0"
}

// ── Libraries / unit tests (dub test) ───────────────────────────────────────
configuration "defaultTest" {
	targetType "library"
	targetName "neko-service-authorization"
	sourcePaths "tests"
	excludedSourceFiles "backend/source/app.d" "backend/source/cli.d" "backend/source/gui.d"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
	excludedSourceFiles "backend/source/app.d" "backend/source/cli.d" "backend/source/gui.d"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
	excludedSourceFiles "backend/source/app.d" "backend/source/cli.d" "backend/source/gui.d"
}
