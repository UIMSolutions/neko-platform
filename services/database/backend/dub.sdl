name "database"
description "HANA-Cloud-ähnliche In-Memory-Spaltendatenbank: vibe.d-Backend (REST, OData v4, SQL), Fiori-3-Frontend, CLI und GtkD-GUI in hexagonaler Architektur"
authors "Ozan Nurettin Süel" "UI Manufaktur (R.I.P)"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

targetPath "build"
sourcePaths "source"
importPaths "source"
stringImportPaths "views"

buildRequirements "allowWarnings" "silenceDeprecations"

dependency "vibe-d" version="~>0.10.5"
dependency "neko-platform:service" path="../../.."
dependency "uim-framework:oop" version="~>26.11.1"


// ── Server: REST (/api/v1), OData v4 (/odata/v4, /odata/v4/cloud), Admin-Web (/admin), Fiori (/ui5)
// dub build          ./build/hdb
configuration "application" {
    targetType "executable"
    targetName "neko-database"
    mainSourceFile "source/app.d"
    dependency "vibe-d" version="~>0.10.5"
    dependency "uim-framework:oop" version="~>26.11.1"
dependency "neko-platform:service" path="../../.."

    excludedSourceFiles "source/gui.d" "source/cli.d" "source/neko/database/presentation/gui/*"
}

// ── Kommandozeile: SQL-Shell (eingebettet oder über den Unix-Socket) und Cloud-Verwaltung über REST
// dub build --config=cli     ./build/hdb-cli --help
configuration "cli" {
    targetType "executable"
    targetName "hdb-cli"
    mainSourceFile "source/cli.d"
    dependency "vibe-d" version="~>0.10.5"
    dependency "uim-framework:oop" version="~>26.11.1"
    dependency "neko-platform:service" path="../../.."
    excludedSourceFiles "source/app.d" "source/gui.d" "source/neko/database/presentation/gui/*"
}

// ── Desktop-Admin-Client mit GtkD (GTK 3). Spricht den Server nur über REST an; kein Server-Code, kein vibe.d.
// dub build --config=gui     ./build/hdb-admin --server=http://localhost:8080
configuration "gui" {
    targetType "executable"
    targetName "hdb-admin"
    mainSourceFile "source/gui.d"
    dependency "gtk-d:gtkd" version="~>3.11.0"
    dependency "neko-platform:service" path="../../.."
    excludedSourceFiles "source/app.d" "source/cli.d" "source/neko/database/package.d" "source/neko/database/embedded.d" \
        "source/neko/database/testing.d" "source/neko/database/application/*" "source/neko/database/domain/*" \
        "source/neko/database/infrastructure/*" "source/neko/database/persistence/*" "source/neko/database/ports/*" \
        "source/neko/database/presentation/package.d" "source/neko/database/presentation/cli/*" \
        "source/neko/database/presentation/http/*" "source/neko/database/presentation/odata/*" \
        "source/neko/database/presentation/rest/*" "source/neko/database/presentation/unix/*" \
        "source/neko/database/presentation/web/*"
}

// ── Eingebettet: die Datenbank als Bibliothek (neko.database.embedded), ohne Server
// dub build --config=library
configuration "library" {
    targetType "library"
    targetName "neko-database"
    dependency "vibe-d" version="~>0.10.5"
    dependency "uim-framework:oop" version="~>26.11.1"
    dependency "neko-platform:service" path="../../.."
    excludedSourceFiles "source/app.d" "source/gui.d" "source/cli.d" "source/neko/database/presentation/gui/*"
}
