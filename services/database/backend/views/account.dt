extends layout

block content
  article.round.border.narrow
    h6 Change password
    p.small-text.muted At least 12 characters. All your sessions end, so you sign in again afterwards.
    form(action="/admin/account/password", method="POST")
      div.field.label.border
        input(type="password", name="current", required=true, autocomplete="current-password")
        label Current password
      div.field.label.border
        input(type="password", name="password", required=true, minlength="12", autocomplete="new-password")
        label New password
      div.field.label.border
        input(type="password", name="confirm", required=true, minlength="12", autocomplete="new-password")
        label Repeat new password
      button(type="submit")
        i key
        span Change password
