extends layout

block content
  div.grid
    div.s12.l6
      article.round.border
        h6 Create backup
        p.small-text.muted Saves all tables from every storage type. Users are not included.
        form.toolbar(action="/admin/backups", method="POST")
          div.field.small.border.max
            input(type="text", name="label", maxlength="40", placeholder="Label (optional)", aria-label="Backup label", autocomplete="off")
          button.small(type="submit")
            i inventory_2
            span Create
    div.s12.l6
      article.round.border
        h6 Upload backup
        p.small-text.muted Adds a .hdbbak file to the list. Nothing is restored yet.
        form.toolbar(action="/admin/backups/upload", method="POST", enctype="multipart/form-data", hx-encoding="multipart/form-data")
          div.field.small.border.prefix.max
            i attach_file
            input(type="file", name="file", accept=".hdbbak", required=true, aria-label="Backup file")
            input(type="text", placeholder="Choose a .hdbbak file", readonly=true)
          button.small.border(type="submit")
            i upload
            span Upload

  article.round.border
    h6 Schedule
    - if (schedule.lastError.length)
      article.round.error-container.notice(role="alert")
        i error
        span.break Last scheduled backup failed: #{schedule.lastError}
    form(action="/admin/backups/schedule", method="POST")
      label.switch
        input(type="checkbox", name="enabled", value="1", checked=schedule.enabled)
        span Automatic backups
      div.form-grid
        div.field.label.border
          input(type="number", name="intervalHours", min="1", max="8760", required=true, value="#{schedule.intervalHours}")
          label Every (hours)
        div.field.label.border
          input(type="number", name="keepScheduled", min="1", max="1000", required=true, value="#{schedule.keepScheduled}")
          label Keep scheduled
        div.field.label.border
          input(type="number", name="keepSafety", min="1", max="1000", required=true, value="#{schedule.keepSafety}")
          label Keep safety backups
      button.small(type="submit")
        i save
        span Save
    p.small-text.muted
      - if (schedule.lastRun.length)
        | Last run: #{schedule.lastRun}.
      - if (schedule.nextRun.length)
        |  Next run: #{schedule.nextRun}.
    p.small-text.muted Only scheduled and safety backups are removed automatically, oldest first. Your own and uploaded backups are kept. Lowering a limit takes effect immediately.
    form.toolbar(action="/admin/backups/retention", method="POST")
      div.field.label.border
        input(type="number", name="retentionDays", min="0", max="215", required=true, value="#{schedule.retentionDays}")
        label Retention (days)
        span.helper 0: by count only, at most 215 days (7 months)
      button.small.border(type="submit")
        i schedule
        span Save retention

  article.round.border
    h6 Backups
    - if (rows.length)
      div.scroll-box
        table.stripes
          thead
            tr
              th Created (UTC)
              th Type
              th Label
              th.right-align Tables
              th.right-align Rows
              th.right-align Size
              th.right-align Actions
          tbody
            - foreach (b; rows)
              tr
                - if (b.readable)
                  td.nowrap(title=b.name) #{b.created}
                  td
                    span.chip.small #{b.kind}
                  td #{b.label}
                  td.right-align #{b.tables}
                  td.right-align #{b.rows}
                - else
                  td.mono(title=b.name) #{b.name}
                  td
                    span.chip.small #{b.kind}
                  td
                    span.chip.small.error Unreadable
                  td
                  td
                td.right-align.nowrap #{b.size}
                td.right-align.nowrap
                  a.button.small.transparent(href="/admin/backups/#{b.name}/download", hx-boost="false") Download
                  - if (b.readable)
                    form.inline(action="/admin/backups/#{b.name}/restore", method="POST", data-confirm="Replace ALL tables with this backup? Changes made since then are lost. The current state is saved first as a safety backup.")
                      button.small.transparent.tertiary-text(type="submit") Restore
                  form.inline(action="/admin/backups/#{b.name}/delete", method="POST", data-confirm="Delete this backup permanently?")
                    button.small.transparent.error-text(type="submit") Delete
    - else
      p.muted No backups yet.
