extends layout

block content
  div.stats
    article.round.border
      div.small-text.muted Tables
      div.value #{view.tables.length}
    article.round.border
      div.small-text.muted Live rows
      div.value #{view.totalRows}
    article.round.border
      div.small-text.muted Rows in delta
      div.value #{view.totalDelta}
      div.small-text.muted Not yet merged into main
    article.round.border
      div.small-text.muted Deleted rows
      div.value #{view.totalDeleted}
      div.small-text.muted Removed at the next merge
    article.round.border
      div.small-text.muted Main store codes
      div.value #{view.totalSize}
      div.small-text.muted Bit-packed, without dictionaries

  div.grid
    div.s12.l8
      article.round.border
        div.toolbar
          h6.max Tables
          - if (page.canCreate)
            button.small(type="button", onclick="create_table_modal.showModal()")
              i add
              span New table
        - if (view.tables.length)
          div.scroll-box
            table.stripes
              thead
                tr
                  th Name
                  th Storage
                  th.right-align Columns
                  th.right-align Live rows
                  th.right-align Delta
                  th.right-align Deleted
                  th.right-align Main codes
              tbody
                - foreach (t; view.tables)
                  tr
                    td
                      a.link.mono(href="/admin/tables/#{t.name}") #{t.name}
                    td
                      span.chip.small #{t.storage}
                    td.right-align #{t.columns}
                    td.right-align #{t.rows}
                    td.right-align #{t.deltaRows}
                    td.right-align #{t.deletedRows}
                    td.right-align #{t.codeSize}
        - else
          p.muted No tables yet. Create one here or in the SQL console.

    div.s12.l4
      article.round.border
        h6 Maintenance
        div.row
          span Delta merge
          - if (view.merge.running)
            span.chip.small.primary Running
          - else
            span.chip.small Idle
        p.small-text.muted Completed in this session: #{view.merge.completed}
        - if (view.merge.lastError.length)
          p.small-text.error-text Last error: #{view.merge.lastError}
        - if (page.canMaintain)
          form(action="/admin/merge", method="POST")
            button.border.responsive(type="submit")
              i merge
              span Run delta merge
          p.small-text.muted Moves delta rows into the compressed main store and removes deleted rows.
          form(action="/admin/checkpoint", method="POST")
            button.border.responsive(type="submit")
              i save
              span Write checkpoint
          p.small-text.muted Rewrites the statement log as a compact snapshot.

  - if (page.canCreate)
    dialog#create_table_modal
      h5 New table
      form(action="/admin/tables", method="POST")
        div.field.label.border
          input.mono(type="text", name="table", required=true, pattern="\\w+", autocomplete="off")
          label Table name
        div.field.label.suffix.border
          select(name="storage")
            option(value="MEMORY", selected=true) Memory: restored from the statement log
            option(value="FILE") File: one compact text file per table
            option(value="JSON") JSON: one readable JSON file per table
            option(value="BINARY") Binary: one compact binary file per table, with checksum
            option(value="BSON") BSON: one BSON document per table, readable with bsondump and MongoDB tools
          label Storage
          i arrow_drop_down
          span.helper File, JSON, Binary and BSON rewrite the whole file on every change, so they suit small tables. Storage can't be changed later.
        p.small-text Columns
        div#column-list
          div.column-row(data-column-row="1")
            div.field.border.max
              input.mono(type="text", name="col_name", placeholder="column_name", aria-label="Column name", required=true, pattern="\\w+", autocomplete="off")
            div.field.suffix.border
              select(name="col_type", aria-label="Column type")
                option(value="BOOLEAN") BOOLEAN
                option(value="TINYINT") TINYINT
                option(value="SBYTE") SBYTE
                option(value="SMALLINT") SMALLINT
                option(value="INT32") INT32
                option(value="INTEGER", selected=true) INTEGER
                option(value="REAL") REAL
                option(value="DECIMAL") DECIMAL
                option(value="NUMERIC") NUMERIC
                option(value="VARCHAR") VARCHAR
                option(value="BLOB") BLOB
                option(value="DATE") DATE
                option(value="TIMESTAMP") TIMESTAMP
                option(value="TIME") TIME
                option(value="DURATION") DURATION
                option(value="GUID") GUID
                option(value="GEO") GEO
                option(value="GEOGRAPHY") GEOGRAPHY
                option(value="LINK") LINK
              i arrow_drop_down
            button.circle.transparent(type="button", data-remove-column="1", aria-label="Remove column")
              i close
        button.transparent.small(type="button", data-add-column="1")
          i add
          span Add column
        nav.right-align
          button.transparent(type="button", onclick="create_table_modal.close()") Cancel
          button(type="submit") Create table
