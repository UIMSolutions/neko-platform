extends layout

block content
  article.round.border
    div.toolbar
      h6.max
        | Additional roles of
        span.mono.gap-left #{view.user}
      a.button.small.transparent(href="/admin/users")
        i arrow_back
        span Users
    p.small-text.muted
      - if (view.role.length)
        | Main role: #{view.role}. The roles below add permissions on top of it.
      - else
        | No main role: this user has only the permissions below.
      - if (view.tenantArea)
        |  With a table, only the table permissions of a role count (select, insert, update, delete, drop). Without a table, the role applies to the whole tenant.
      |  Start and end are optional and in UTC. Outside that time a grant has no effect, also in sessions that are already open.
    div.scroll-box
      table.stripes
        thead
          tr
            - if (view.tenantArea)
              th Table
            th Role
            th From (UTC)
            th Until (UTC)
            th Status
            th.right-align Actions
        tbody
          - foreach (row; view.grants)
            tr(class=row.state == "expired" ? "dim" : "")
              - if (view.tenantArea)
                td.mono #{row.grant.table.length ? row.grant.table : "(whole tenant)"}
              td.mono #{row.grant.role}
              td.mono.small-text #{row.grant.from.length ? row.grant.from : "—"}
              td.mono.small-text #{row.grant.until.length ? row.grant.until : "—"}
              td
                - if (row.state == "active")
                  span.chip.small.primary #{row.grant.temporary ? "Active" : "Permanent"}
                - else if (row.state == "scheduled")
                  span.chip.small.secondary Scheduled
                - else
                  span.chip.small Expired
              td.right-align
                form.inline(action="/admin/users/#{view.user}/grants", method="POST")
                  input(type="hidden", name="action", value="remove")
                  input(type="hidden", name="table", value=row.grant.table)
                  input(type="hidden", name="role", value=row.grant.role)
                  input(type="hidden", name="from", value=row.grant.from)
                  input(type="hidden", name="until", value=row.grant.until)
                  button.small.transparent.error-text(type="submit") Remove
          - if (view.grants.length == 0)
            tr
              td.muted(colspan="6") No additional roles yet
    - if (view.hasExpired)
      form(action="/admin/users/#{view.user}/grants", method="POST")
        input(type="hidden", name="action", value="purge")
        button.small.transparent(type="submit") Remove expired grants

    form.form-grid(action="/admin/users/#{view.user}/grants", method="POST")
      input(type="hidden", name="action", value="add")
      - if (view.tenantArea)
        div.field.label.border
          input.mono(type="text", name="table", pattern="\\w*", list="known-tables", autocomplete="off")
          label Table (empty: whole tenant)
          datalist#known-tables
            - foreach (t; view.tables)
              option(value=t)
      div.field.label.suffix.border
        select(name="role", required=true)
          - foreach (r; view.roles)
            option(value=r) #{r}
        label Role
        i arrow_drop_down
      div.field.label.border
        input(type="datetime-local", name="from")
        label From (UTC, optional)
      div.field.label.border
        input(type="datetime-local", name="until")
        label Until (UTC, optional)
      button(type="submit")
        i add
        span Grant
