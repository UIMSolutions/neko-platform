doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{page.title} - hdb Admin
    link(rel="icon", href="data:,")
    //- beer.css (Material Design 3) und htmx: feste Versionen, beide vom CDN
    link(href="https://cdn.jsdelivr.net/npm/beercss@3.13.3/dist/cdn/beer.min.css", rel="stylesheet")
    link(href="/admin.css", rel="stylesheet")
    script(type="module", src="https://cdn.jsdelivr.net/npm/beercss@3.13.3/dist/cdn/beer.min.js")
    script(src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js")
    //- Auch Fehlerseiten (4xx/5xx) ersetzen den Inhalt, sonst bliebe ein abgelehntes Formular stumm
    meta(name="htmx-config", content="{\"responseHandling\":[{\"code\":\"204\",\"swap\":false},{\"code\":\".*\",\"swap\":true}],\"scrollIntoViewOnBoost\":false}")
    script(src="/admin.js", defer=true)

  //- hx-boost: Links und Formulare laden nur den Inhalt nach; ohne JavaScript funktioniert alles wie bisher
  body.dark(hx-boost="true", hx-indicator="#busy")
    progress#busy.htmx-indicator

    nav.left.max.l.surface-container
      include nav_items

    dialog#nav-drawer.left.surface-container
      nav.drawer
        include nav_items

    header.fixed
      nav
        button.circle.transparent.m.s(type="button", data-drawer="nav-drawer", aria-label="Open navigation")
          i menu
        h5.max #{page.title}

    main.responsive
      - if (page.locked)
        article.round.tertiary-container.notice(role="alert")
          i lock
          span An open transaction is locking the database. It rolls back after 30 seconds without activity.
      - if (page.replicaOf.length)
        article.round.secondary-container.notice(role="status")
          i sync
          span
            | This tenant is a read-only replica of
            span.mono.gap-left #{page.replicaOf}
            | . Changes come from there. Stop the replication to change data here.
      - if (page.ok.length)
        article.round.primary-container.notice(role="status")
          i check_circle
          span #{page.ok}
      - if (page.err.length)
        article.round.error-container.notice(role="alert")
          i error
          span.break #{page.err}
      block content
