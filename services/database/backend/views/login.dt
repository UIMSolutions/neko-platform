doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Sign in - hdb Admin
    link(rel="icon", href="data:,")
    link(href="https://cdn.jsdelivr.net/npm/beercss@3.13.3/dist/cdn/beer.min.css", rel="stylesheet")
    link(href="/admin.css", rel="stylesheet")
    script(type="module", src="https://cdn.jsdelivr.net/npm/beercss@3.13.3/dist/cdn/beer.min.js")

  //- Ohne hx-boost: nach der Anmeldung lädt die Admin-Oberfläche mit ihrem eigenen Gerüst (htmx, admin.js)
  body.dark
    main.responsive.login
      article.round.border.login-card
        header
          nav
            i.primary-text database
            h5.max hdb Admin
        - if (loginNotice.length)
          article.round.primary-container.notice(role="status")
            i check_circle
            span #{loginNotice}
        - if (loginError.length)
          article.round.error-container.notice(role="alert")
            i error
            span #{loginError}
        form(action="/admin/login", method="POST")
          - if (!singleTenant)
            div.field.label.border
              input.mono(type="text", name="tenant", value=tenantValue, autocomplete="organization", autocapitalize="none", spellcheck="false")
              label Tenant
              span.helper Leave empty for the default tenant. System administrators use "system".
          div.field.label.border
            input(type="text", name="user", required=true, autofocus=true, autocomplete="username")
            label User name
          div.field.label.border
            input(type="password", name="password", required=true, autocomplete="current-password")
            label Password
          button.responsive(type="submit")
            i login
            span Sign in
