extends layout

block content
  article.round.border.medium-width
    h6 Allowed networks
    p.small-text.muted Users of tenant #{page.tenant} can sign in and work only from these IP addresses and networks. Leave the list empty to allow all addresses. Changes apply at once, also to sessions that are already open.
    article.round.surface-container-high.notice(role="status")
      i location_on
      span
        | Your current address:
        span.mono  #{view.yourAddress.length ? view.yourAddress : "unknown"}
    form(action="/admin/network", method="POST")
      div.field.textarea.label.border.extra
        textarea.mono(name="networks", rows="8", spellcheck="false", autocapitalize="none") #{view.networksText}
        label One address or network per line, IPv4 or IPv6
        span.helper e.g. 192.168.10.0/24, 203.0.113.7 or 2001:db8::/32
      p.small-text.muted A list that leaves out your current address is refused, so you can't lock yourself out. A replica that copies this tenant needs its address in the list too, and local tools on the Unix socket count as 127.0.0.1.
      button(type="submit")
        i save
        span Save
