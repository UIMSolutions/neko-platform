extends layout

block content
  article.round.border
    div.toolbar
      h6.max This tenant as a replica
      - if (!status.replica)
        span.chip.small Off
      - else if (status.state == "streaming")
        span.chip.small.primary Up to date
      - else if (status.state == "error")
        span.chip.small.error Error
      - else
        span.chip.small.tertiary #{status.state == "syncing" ? "Full sync" : "Connecting"}
    p.small-text.muted A replica copies all tables of a tenant on another hdb server and keeps them up to date. While it runs, this tenant is read-only. The first run replaces all tables of this tenant with those of the source.
    - if (status.replica)
      div.scroll-box
        table
          tbody
            tr
              th Source
              td.mono #{status.url}, tenant #{status.sourceTenant}, user #{status.user}
            tr
              th Applied changes
              td #{status.appliedSequence}
            tr
              th Last successful run (UTC)
              td #{status.lastSync.length ? status.lastSync : "Not yet"}
            - if (status.lastError.length)
              tr
                th Last error
                td.error-text.break #{status.lastError}
      div.toolbar
        form.inline(action="/admin/replication/resync", method="POST")
          button.small.border(type="submit")
            i restart_alt
            span Full sync now
        form.inline(action="/admin/replication/stop", method="POST", data-confirm="Stop the replication? This tenant keeps its current data and accepts changes again. Starting again later replaces all tables.")
          button.small.border.tertiary-text(type="submit")
            i stop_circle
            span Stop replication

    form(action="/admin/replication", method="POST", data-confirm=status.replica ? "" : "Start the replication? All tables of this tenant are replaced with those of the source, and this tenant becomes read-only.")
      div.field.label.border
        input.mono(type="url", name="url", required=true, value=status.url, autocomplete="off")
        label Source server URL
        span.helper e.g. https://primary.example.org:8080
      div.form-grid
        div.field.label.border
          input.mono(type="text", name="tenant", value=status.sourceTenant, autocomplete="off", autocapitalize="none", spellcheck="false")
          label Tenant on the source (empty: default)
        div.field.label.border
          input(type="number", name="interval", min="1", max="3600", value=status.intervalSeconds ? status.intervalSeconds : 2)
          label Check every (seconds)
        div.field.label.border
          input.mono(type="text", name="user", required=true, value=status.user, autocomplete="off")
          label User on the source
        div.field.label.border
          input(type="password", name="password", required=!status.replica, autocomplete="new-password")
          label #{status.replica ? "Password (empty: unchanged)" : "Password"}
      p.small-text.muted The password is stored on this server so it can sign in again. A user with the viewer role on the source is enough.
      button(type="submit") #{status.replica ? "Save" : "Start replication"}

  article.round.border
    h6 This tenant as a source
    p.small-text.muted Other hdb servers can replicate this tenant. Create a user with the viewer role for them, and enter this server's URL, the tenant #{page.tenant} and that user on the replica.
    div.scroll-box
      table
        tbody
          tr
            th Changes so far
            td #{status.sequence}
          tr
            th Oldest change available
            td #{status.retainedFrom}
          tr
            th Epoch
            td.mono.small-text #{status.epoch}
    p.small-text.muted The change count starts again after a restart of this server or a restore, and replicas then fetch a full copy. A replica that falls further behind than the available changes does the same.
