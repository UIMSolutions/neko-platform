extends layout

block content
  article.round.border
    div.toolbar
      h6.max Roles
      button.small(type="button", data-role-new="1")
        i add
        span New role
    - if (page.isSystem)
      p.small-text.muted Roles of the system area. They decide what system users can do on the server.
    - else
      p.small-text.muted Roles of tenant #{page.tenant}. A user's role applies to all tables. For table access, only the permissions #{view.tableOnly} of a role count. Changes apply at once, also to users who are signed in.
    div.scroll-box
      table.stripes
        thead
          tr
            th Role
            th Permissions
            th.right-align Users
            th.right-align Actions
        tbody
          - foreach (r; view.roles)
            tr
              td
                span.mono #{r.name}
                - if (r.builtin)
                  span.chip.small.gap-left Built in
                - if (r.description.length)
                  div.small-text.muted #{r.description}
              td
                - foreach (p; r.permissions)
                  span.chip.small.border.mono #{p}
                - if (r.permissions.length == 0)
                  span.small-text.muted None
              td.right-align #{r.users}
              td.right-align.nowrap
                - if (!r.builtin)
                  button.small.transparent(type="button", data-role-edit=r.name, data-role-description=r.description, data-role-permissions=r.permissionList) Edit
                  - if (r.users == 0)
                    form.inline(action="/admin/roles/#{r.name}/delete", method="POST", data-confirm="Delete role #{r.name}?")
                      button.small.transparent.error-text(type="submit") Delete

  dialog#role_modal
    h5#role-title New role
    form#role-form(action="/admin/roles", method="POST")
      div.field.label.border
        input#role-name.mono(type="text", name="role", required=true, maxlength="64", autocomplete="off", autocapitalize="none", spellcheck="false")
        label Name
      div.field.label.border
        input#role-description(type="text", name="description", maxlength="200", autocomplete="off")
        label Description (optional)
      p.small-text Permissions
      div.perm-grid
        - foreach (p; view.allowed)
          label.checkbox
            input(type="checkbox", name="permission", value=p, data-permission=p)
            span.mono #{p}
      nav.right-align
        button.transparent(type="button", onclick="role_modal.close()") Cancel
        button(type="submit") Save role
