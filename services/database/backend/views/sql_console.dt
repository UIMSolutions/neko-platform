extends layout

block content
  - if (view.transaction.length)
    article.round.tertiary-container.notice(role="status")
      i lock
      span.max Transaction open. Everyone else is locked out until you finish it. It rolls back after 30 seconds without activity.
      form.inline(action="/admin/sql", method="POST")
        input(type="hidden", name="transaction", value=view.transaction)
        input(type="hidden", name="statement", value="COMMIT")
        button.small(type="submit") Commit
      form.inline(action="/admin/sql", method="POST")
        input(type="hidden", name="transaction", value=view.transaction)
        input(type="hidden", name="statement", value="ROLLBACK")
        button.small.border(type="submit") Roll back

  form#sql-form(action="/admin/sql", method="POST")
    input(type="hidden", name="transaction", value=view.transaction)
    div.field.textarea.border.extra
      textarea#sql-input.mono(name="statement", aria-label="SQL statements", placeholder="SELECT * FROM table_name LIMIT 10", spellcheck="false", autofocus=true, rows="8") #{view.input}
    div.toolbar
      span.max.small-text.muted Separate statements with a semicolon. Execution stops at the first error.
      button(type="submit")
        i play_arrow
        span Run (Ctrl+Enter)

  - foreach (r; view.results)
    article.round.border
      div.toolbar
        code.max.break #{r.sql}
        span.small-text.muted.nowrap #{r.elapsed}
      - if (r.error.length)
        article.round.error-container.notice(role="alert")
          i error
          span.break #{r.error}
      - else if (r.columns.length)
        div.scroll-box.tall
          table.stripes
            thead.fixed
              tr
                - foreach (c; r.columns)
                  th.mono #{c}
            tbody
              - foreach (row; r.rows)
                tr
                  - foreach (c; row)
                    - if (c.isNull)
                      td
                        span.chip.small NULL
                    - else
                      td.mono #{c.text}
        - if (r.rows.length < r.totalRows)
          p.small-text.muted Showing the first #{r.rows.length} of #{r.totalRows} rows.
        - else
          p.small-text.muted #{r.totalRows} row(s)
      - else
        p.small-text.muted #{r.message}
