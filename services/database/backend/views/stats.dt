extends layout

block content
  div.stats
    article.round.border
      div.small-text.muted Tables
      div.value #{view.tables.length}
      div.small-text.muted #{view.totalColumns} columns
    article.round.border
      div.small-text.muted Live rows
      div.value #{view.overview.totalRows}
    article.round.border
      div.small-text.muted Rows in delta
      div.value #{view.overview.totalDelta}
      div.small-text.muted Not yet merged into main
    article.round.border
      div.small-text.muted Deleted rows
      div.value #{view.overview.totalDeleted}
      div.small-text.muted Removed at the next merge
    article.round.border
      div.small-text.muted Main store codes
      div.value #{view.overview.totalSize}
      div.small-text.muted Bit-packed, without dictionaries

  article.round.border
    div.toolbar
      h6 Delta merge
      - if (view.overview.merge.running)
        span.chip.small.primary
          i.small autorenew
          span Running
      - else
        span.chip.small Idle
      span.max.small-text.muted Completed in this session: #{view.overview.merge.completed}
      a.link.small-text(href="/admin/help#statistics") What do these numbers mean?
    - if (view.overview.merge.lastError.length)
      p.small-text.error-text Last error: #{view.overview.merge.lastError}

  - foreach (t; view.tables)
    article.round.border
      div.toolbar
        h6
          a.link.mono(href="/admin/tables/#{t.summary.name}") #{t.summary.name}
        span.chip.small #{t.summary.storage}
        span.small-text.muted #{t.summary.rows} live, #{t.summary.deltaRows} in delta, #{t.summary.deletedRows} deleted, #{t.summary.codeSize} codes
      div.scroll-box
        table.stripes
          thead
            tr
              th Column
              th Type
              th.right-align Main rows
              th.right-align Delta rows
              th.right-align Main distinct
              th.right-align Delta distinct
              th.right-align Bits per value
              th.right-align Code size
          tbody
            - foreach (c; t.columns)
              tr
                td.mono #{c.name}
                td #{c.type}
                td.right-align #{c.stats.mainRows}
                td.right-align #{c.stats.deltaRows}
                td.right-align #{c.stats.mainDistinct}
                td.right-align #{c.stats.deltaDistinct}
                td.right-align #{c.stats.mainBits}
                td.right-align #{c.codeSize}
  - if (view.tables.length == 0 && page.err.length == 0)
    article.round.border
      p.muted No tables yet, so there is nothing to measure.
