extends layout

block content
  div.toolbar
    p.max.muted
      span.chip.small #{view.storage}
      span.gap-left #{view.live} live rows · #{view.deleted} deleted · #{view.columns.length} columns
    - if (view.canInsert)
      button.small(type="button", data-row-insert="1")
        i add
        span Add row
    a.button.small.border(href=view.consoleUrl)
      i terminal
      span Open in console
    a.button.small.border(href=view.exportUrl, hx-boost="false")
      i download
      span Export CSV
    - if (view.canDelete)
      form.inline(action="/admin/tables/#{view.name}/truncate", method="POST", data-confirm="Delete all rows in #{view.name}?")
        button.small.border.tertiary-text(type="submit") Delete all rows
    - if (view.canDrop)
      form.inline(action="/admin/tables/#{view.name}/drop", method="POST", data-confirm-name=view.name)
        button.small.border.error-text(type="submit") Drop table

  form.toolbar(method="GET")
    - if (view.sort.length)
      input(type="hidden", name="sort", value=view.sort)
      input(type="hidden", name="dir", value=view.desc ? "desc" : "asc")
    div.field.small.border.max
      input.mono(type="text", name="where", value=view.where, placeholder="WHERE condition, e.g. amount >= 10 AND name LIKE 'A%'", aria-label="WHERE condition")
    div.field.small.suffix.border
      select(name="size", aria-label="Rows per page", data-autosubmit="1")
        - foreach (n; [25, 50, 100, 250, 500])
          option(value="#{n}", selected=view.pageSize == n) #{n} rows
      i arrow_drop_down
    button.small(type="submit")
      i filter_alt
      span Filter
    - if (view.where.length)
      a.button.small.transparent(href="/admin/tables/#{view.name}") Clear

  - if (view.queryError.length)
    article.round.error-container.notice(role="alert")
      i error
      span.break #{view.queryError}

  article.round.border
    div.scroll-box
      table.stripes
        thead
          tr
            - foreach (c; view.columns)
              th
                a.link.mono(href=view.sortUrl(c.name)) #{c.name}#{view.sortMark(c.name)}
                div.small-text.muted #{c.type}
            - if (view.canUpdate || view.canDelete)
              th.right-align Actions
        tbody
          - foreach (row; view.rows)
            tr(data-values=row.match)
              - foreach (i, c; row.cells)
                - if (c.isNull)
                  td
                    span.chip.small NULL
                - else if (view.columns[i].type == "LINK")
                  td.mono.cell.truncate(title=c.text)
                    a.link(href=c.text, target="_blank", rel="noopener noreferrer", hx-boost="false") #{c.text}
                - else
                  td.mono.cell.truncate(title=c.text) #{c.text}
              - if (view.canUpdate || view.canDelete)
                td.right-align.nowrap
                  - if (view.canUpdate)
                    button.circle.transparent.small(type="button", data-row-edit="1", title="Edit row", aria-label="Edit row")
                      i edit
                  - if (view.canDelete)
                    form.inline(action="/admin/tables/#{view.name}/rows/delete", method="POST", data-confirm="Delete this row? Rows with identical values are deleted too.")
                      input(type="hidden", name="match", value=row.match)
                      input(type="hidden", name="back", value=view.backQuery)
                      button.circle.transparent.small.error-text(type="submit", title="Delete row", aria-label="Delete row")
                        i delete
          - if (view.rows.length == 0 && view.queryError.length == 0)
            tr
              td.center-align.muted(colspan="#{view.columns.length + 1}") No rows found

    div.toolbar
      span.max.small-text.muted Showing #{view.firstRow} to #{view.lastRow} of #{view.matching} rows
      nav.no-space
        - if (view.page <= 1)
          button.small.border.left-round(disabled=true) «
        - else
          a.button.small.border.left-round(href=view.pageUrl(view.page - 1)) «
        button.small.border.no-round(disabled=true) Page #{view.page} of #{view.pageCount}
        - if (view.page >= view.pageCount)
          button.small.border.right-round(disabled=true) »
        - else
          a.button.small.border.right-round(href=view.pageUrl(view.page + 1)) »

  article.round.border
    h6 Column storage
    div.scroll-box
      table.stripes
        thead
          tr
            th Column
            th Type
            th.right-align Main rows
            th.right-align Delta rows
            th.right-align Main distinct
            th.right-align Delta distinct
            th.right-align Bits per value
            th.right-align Main codes
        tbody
          - foreach (c; view.columns)
            tr
              td.mono #{c.name}
              td #{c.type}
              td.right-align #{c.stats.mainRows}
              td.right-align #{c.stats.deltaRows}
              td.right-align #{c.stats.mainDistinct}
              td.right-align #{c.stats.deltaDistinct}
              td.right-align #{c.stats.mainBits}
              td.right-align #{c.codeSize}

  - if (view.canInsert || view.canUpdate)
    dialog#row_modal
      h5#row-title Add row
      p#row-duplicate-note.small-text.muted.hidden Rows with identical values are updated too.
      form#row-form(method="POST", data-insert="/admin/tables/#{view.name}/rows", data-update="/admin/tables/#{view.name}/rows/update")
        input#row-match(type="hidden", name="match", value="")
        input(type="hidden", name="back", value=view.backQuery)
        - foreach (i, c; view.columns)
          div.column-row
            div.field.label.border.max
              - if (c.inputType == "text")
                input(id="row-v#{i}", type="text", name="v#{i}", data-field="#{i}", autocomplete="off")
              - else if (c.inputType == "integer")
                input(id="row-v#{i}", type="number", step="1", name="v#{i}", data-field="#{i}", autocomplete="off")
              - else
                input(id="row-v#{i}", type="number", step="any", name="v#{i}", data-field="#{i}", autocomplete="off")
              label(for="row-v#{i}") #{c.name} · #{c.type}
            label.checkbox
              input(type="checkbox", name="n#{i}", value="1", data-null="#{i}")
              span NULL
        nav.right-align
          button.transparent(type="button", onclick="row_modal.close()") Cancel
          button(type="submit") Save
