extends layout

block content
  article.round.border
    div.toolbar
      h6.max Tenants
      button.small(type="button", onclick="tenant_modal.showModal()")
        i domain_add
        span New tenant
    p.small-text.muted Each tenant has its own tables, users and backups. Users sign in with the tenant name. As a system administrator you manage tenants, but you can't see their data.
    div.scroll-box
      table.stripes
        thead
          tr
            th Tenant
            th Label
            th.right-align Users
            th Networks
            th Status
            th.right-align Actions
        tbody
          - foreach (t; rows)
            tr
              td
                span.mono #{t.name}
              td
                form.toolbar(action="/admin/tenants/#{t.name}/update", method="POST")
                  - if (t.active)
                    input(type="hidden", name="active", value="1")
                  div.field.small.border
                    input(type="text", name="label", value=t.label, maxlength="100", aria-label="Label of #{t.name}")
                  button.small.transparent(type="submit") Save
              td.right-align #{t.users}
              td
                details
                  summary.small-text #{t.networkCount == 0 ? "All" : t.networkCount == 1 ? "1 network" : t.networkCount.to!string ~ " networks"}
                  form(action="/admin/tenants/#{t.name}/networks", method="POST")
                    div.field.textarea.small.border
                      textarea.mono(name="networks", rows="4", spellcheck="false", aria-label="Allowed networks of #{t.name}") #{t.networksText}
                    button.small.transparent(type="submit") Save
              td
                - if (t.active)
                  span.chip.small.primary Active
                - else
                  span.chip.small Disabled
              td.right-align.nowrap
                - if (t.active)
                  form.inline(action="/admin/tenants/#{t.name}/update", method="POST", data-confirm="Disable tenant #{t.name}? Its users are signed out and can't sign in until you enable it again.")
                    input(type="hidden", name="label", value=t.label)
                    button.small.transparent(type="submit") Disable
                - else
                  form.inline(action="/admin/tenants/#{t.name}/update", method="POST")
                    input(type="hidden", name="label", value=t.label)
                    input(type="hidden", name="active", value="1")
                    button.small.transparent(type="submit") Enable
                  form.inline(action="/admin/tenants/#{t.name}/delete", method="POST", data-confirm-name=t.name, data-confirm-what="tenant #{t.name} with all its users, tables and backups")
                    button.small.transparent.error-text(type="submit") Delete
          - if (rows.length == 0)
            tr
              td.muted(colspan="6") No tenants yet
    p.small-text.muted Disable a tenant before you delete it. Deleting removes its users, tables and backups for good.

  dialog#tenant_modal
    h5 New tenant
    form(action="/admin/tenants", method="POST")
      div.field.label.border
        input.mono(type="text", name="tenant", required=true, maxlength="32", pattern="[a-z0-9][a-z0-9_\\-]*", autocomplete="off", autocapitalize="none", spellcheck="false")
        label Tenant name
        span.helper Lowercase letters, digits, '_' and '-'. Users type it when they sign in, and it can't be changed later.
      div.field.label.border
        input(type="text", name="label", maxlength="100", autocomplete="off")
        label Label (optional)
      p.small-text.bold First administrator
      div.field.label.border
        input.mono(type="text", name="user", required=true, value="admin", autocomplete="off")
        label User name
      div.field.label.border
        input(type="password", name="password", required=true, minlength="12", autocomplete="new-password")
        label Password (at least 12 characters)
      div.field.label.border
        input(type="password", name="confirm", required=true, minlength="12", autocomplete="new-password")
        label Repeat password
      nav.right-align
        button.transparent(type="button", onclick="tenant_modal.close()") Cancel
        button(type="submit") Create tenant
