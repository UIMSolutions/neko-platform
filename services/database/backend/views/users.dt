extends layout

block content
  article.round.border
    div.toolbar
      h6.max Users
      button.small(type="button", onclick="user_modal.showModal()")
        i person_add
        span New user
    - if (page.isSystem)
      p.small-text.muted Users of the system area. Their role decides what they can do on the server: see or manage tenants, and manage system users. They can't see tenant data.
    - else
      p.small-text.muted
        | Users of tenant #{page.tenant}. The role applies to all tables. Table access adds roles for single tables, so a user without a role sees only those tables. Define your own roles under
        a.link(href="/admin/roles")  Roles
        | .
    div.scroll-box
      table.stripes
        thead
          tr
            th Name
            th Role
            th Additional roles
            th Status
            th.right-align Actions
        tbody
          - foreach (u; view.users)
            tr
              td
                span.mono #{u.name}
                - if (u.self)
                  span.chip.small  You
              td
                form(action="/admin/users/#{u.name}/update", method="POST")
                  - if (u.active)
                    input(type="hidden", name="active", value="1")
                  div.field.small.suffix.border
                    select(name="role", aria-label="Role of #{u.name}", data-autosubmit="1")
                      - if (view.tables)
                        option(value="", selected=u.role.length == 0) (none)
                      - foreach (r; view.roles)
                        option(value=r, selected=r == u.role) #{r}
                    i arrow_drop_down
              td
                a.link.small-text(href="/admin/users/#{u.name}/grants") #{u.grants == 0 ? "None" : u.grants == 1 ? "1 grant" : u.grants.to!string ~ " grants"}
              td
                - if (u.active)
                  span.chip.small.primary Active
                - else
                  span.chip.small Disabled
              td.right-align.nowrap
                form.inline(action="/admin/users/#{u.name}/update", method="POST")
                  input(type="hidden", name="role", value=u.role)
                  - if (!u.active)
                    input(type="hidden", name="active", value="1")
                  button.small.transparent(type="submit") #{u.active ? "Disable" : "Enable"}
                button.small.transparent(type="button", data-reset-user=u.name) Reset password
                form.inline(action="/admin/users/#{u.name}/delete", method="POST", data-confirm="Delete user #{u.name}?")
                  button.small.transparent.error-text(type="submit") Delete

  dialog#user_modal
    h5 New user
    form(action="/admin/users", method="POST")
      div.field.label.border
        input.mono(type="text", name="user", required=true, autocomplete="off")
        label User name
      div.field.label.suffix.border
        select(name="role")
          - foreach (r; view.roles)
            option(value=r, selected=r == "viewer") #{r}
          - if (view.tables)
            option(value="") (none: table access only)
        label Role
        i arrow_drop_down
      div.field.label.border
        input(type="password", name="password", required=true, minlength="12", autocomplete="new-password")
        label Password (at least 12 characters)
      div.field.label.border
        input(type="password", name="confirm", required=true, minlength="12", autocomplete="new-password")
        label Repeat password
      nav.right-align
        button.transparent(type="button", onclick="user_modal.close()") Cancel
        button(type="submit") Create user

  dialog#reset_modal
    h5#reset-title Reset password
    p.small-text.muted This signs the user out everywhere.
    form#reset-form(method="POST")
      div.field.label.border
        input(type="password", name="password", required=true, minlength="12", autocomplete="new-password")
        label New password (at least 12 characters)
      div.field.label.border
        input(type="password", name="confirm", required=true, minlength="12", autocomplete="new-password")
        label Repeat password
      nav.right-align
        button.transparent(type="button", onclick="reset_modal.close()") Cancel
        button(type="submit") Reset password
