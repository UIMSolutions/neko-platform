<?xml version="1.0" ?>
<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Namespace="Org.OData.Core.V1" Alias="Core"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="hdb.cloud">
      <EntityType Name="WorkloadClass">
        <Key>
          <PropertyRef Name="name"/>
        </Key>
        <Property Name="name" Type="Edm.String" Nullable="false"/>
        <Property Name="priority" Type="Edm.Int32"/>
        <Property Name="statementTimeoutSeconds" Type="Edm.Int32"/>
        <Property Name="statementMemoryLimitMb" Type="Edm.Int32"/>
        <Property Name="totalStatementLimit" Type="Edm.Int32"/>
        <Property Name="statementThreadLimit" Type="Edm.Int32"/>
        <Property Name="enabled" Type="Edm.Boolean"/>
        <Property Name="description" Type="Edm.String"/>
      </EntityType>
      <EntityType Name="WorkloadMapping">
        <Key>
          <PropertyRef Name="name"/>
        </Key>
        <Property Name="name" Type="Edm.String" Nullable="false"/>
        <Property Name="workloadClass" Type="Edm.String"/>
        <Property Name="userName" Type="Edm.String"/>
        <Property Name="roleName" Type="Edm.String"/>
      </EntityType>
      <EntityType Name="Trace">
        <Key>
          <PropertyRef Name="id"/>
        </Key>
        <Property Name="id" Type="Edm.Int32" Nullable="false"/>
        <Property Name="time" Type="Edm.DateTimeOffset"/>
        <Property Name="user" Type="Edm.String"/>
        <Property Name="kind" Type="Edm.String"/>
        <Property Name="statement" Type="Edm.String"/>
        <Property Name="verb" Type="Edm.String"/>
        <Property Name="tables" Type="Edm.String"/>
        <Property Name="durationMs" Type="Edm.Double"/>
        <Property Name="rows" Type="Edm.Int32"/>
        <Property Name="affected" Type="Edm.Int32"/>
        <Property Name="error" Type="Edm.String"/>
        <Property Name="workloadClass" Type="Edm.String"/>
      </EntityType>
      <EntityType Name="Metric">
        <Key>
          <PropertyRef Name="time"/>
        </Key>
        <Property Name="time" Type="Edm.DateTimeOffset" Nullable="false"/>
        <Property Name="statements" Type="Edm.Int32"/>
        <Property Name="errors" Type="Edm.Int32"/>
        <Property Name="expensive" Type="Edm.Int32"/>
        <Property Name="avgMs" Type="Edm.Double"/>
        <Property Name="maxMs" Type="Edm.Double"/>
        <Property Name="tables" Type="Edm.Int32"/>
        <Property Name="rows" Type="Edm.Double"/>
        <Property Name="memoryBytes" Type="Edm.Double"/>
        <Property Name="cpuPercent" Type="Edm.Double"/>
        <Property Name="residentBytes" Type="Edm.Double"/>
        <Property Name="reads" Type="Edm.Int32"/>
        <Property Name="writes" Type="Edm.Int32"/>
      </EntityType>
      <EntityType Name="TableAccessEntry">
        <Key>
          <PropertyRef Name="table"/>
        </Key>
        <Property Name="table" Type="Edm.String" Nullable="false"/>
        <Property Name="reads" Type="Edm.Int32"/>
        <Property Name="writes" Type="Edm.Int32"/>
        <Property Name="filters" Type="Edm.Int32"/>
        <Property Name="filterColumns" Type="Edm.String"/>
        <Property Name="lastAccess" Type="Edm.DateTimeOffset"/>
      </EntityType>
      <EntityType Name="Recommendation">
        <Key>
          <PropertyRef Name="id"/>
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false"/>
        <Property Name="advisor" Type="Edm.String"/>
        <Property Name="severity" Type="Edm.String"/>
        <Property Name="target" Type="Edm.String"/>
        <Property Name="title" Type="Edm.String"/>
        <Property Name="detail" Type="Edm.String"/>
        <Property Name="action" Type="Edm.String"/>
        <Property Name="executable" Type="Edm.Boolean"/>
        <Property Name="benefit" Type="Edm.Double"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset"/>
      </EntityType>
      <EntityType Name="CalculationView">
        <Key>
          <PropertyRef Name="name"/>
        </Key>
        <Property Name="name" Type="Edm.String" Nullable="false"/>
        <Property Name="label" Type="Edm.String"/>
        <Property Name="description" Type="Edm.String"/>
        <Property Name="viewType" Type="Edm.String"/>
        <Property Name="baseTable" Type="Edm.String"/>
        <Property Name="tables" Type="Edm.String"/>
        <Property Name="attributes" Type="Edm.String"/>
        <Property Name="measures" Type="Edm.String"/>
        <Property Name="filter" Type="Edm.String"/>
        <Property Name="entitySet" Type="Edm.String"/>
        <Property Name="createdBy" Type="Edm.String"/>
        <Property Name="updatedAt" Type="Edm.DateTimeOffset"/>
      </EntityType>
      <EntityType Name="CV_REVENUEType">
        <Key>
          <PropertyRef Name="ID"/>
        </Key>
        <Property Name="ID" Type="Edm.Int32" Nullable="false"/>
        <Property Name="STATUS" Type="Edm.String"/>
        <Property Name="REVENUE" Type="Edm.Double"/>
        <Property Name="ORDERS" Type="Edm.Int64"/>
      </EntityType>
      <EntityType Name="Binding">
        <Key>
          <PropertyRef Name="name"/>
        </Key>
        <Property Name="name" Type="Edm.String" Nullable="false"/>
        <Property Name="application" Type="Edm.String"/>
        <Property Name="tenant" Type="Edm.String"/>
        <Property Name="user" Type="Edm.String"/>
        <Property Name="role" Type="Edm.String"/>
        <Property Name="createdAt" Type="Edm.DateTimeOffset"/>
        <Property Name="createdBy" Type="Edm.String"/>
      </EntityType>
      <EntityType Name="DataProduct">
        <Key>
          <PropertyRef Name="id"/>
        </Key>
        <Property Name="id" Type="Edm.String" Nullable="false"/>
        <Property Name="title" Type="Edm.String"/>
        <Property Name="description" Type="Edm.String"/>
        <Property Name="provider" Type="Edm.String"/>
        <Property Name="version" Type="Edm.String"/>
        <Property Name="tags" Type="Edm.String"/>
        <Property Name="tables" Type="Edm.String"/>
        <Property Name="rows" Type="Edm.Int32"/>
        <Property Name="installed" Type="Edm.Boolean"/>
        <Property Name="installedAt" Type="Edm.DateTimeOffset"/>
        <Property Name="installedTables" Type="Edm.String"/>
      </EntityType>
      <Action Name="RunAdvisors">
        <Parameter Name="advisors" Type="Edm.String"/>
        <ReturnType Type="Collection(hdb.cloud.Recommendation)"/>
      </Action>
      <Action Name="InstallDataProduct">
        <Parameter Name="id" Type="Edm.String" Nullable="false"/>
      </Action>
      <Action Name="UninstallDataProduct">
        <Parameter Name="id" Type="Edm.String" Nullable="false"/>
      </Action>
      <Action Name="ClearTraces"/>
      <Function Name="IssueSummary">
        <ReturnType Type="Edm.String"/>
      </Function>
      <Action Name="Ask">
        <Parameter Name="message" Type="Edm.String" Nullable="false"/>
        <ReturnType Type="Edm.String"/>
      </Action>
      <EntityContainer Name="Container">
        <EntitySet Name="WorkloadClasses" EntityType="hdb.cloud.WorkloadClass"/>
        <EntitySet Name="WorkloadMappings" EntityType="hdb.cloud.WorkloadMapping"/>
        <EntitySet Name="Traces" EntityType="hdb.cloud.Trace"/>
        <EntitySet Name="Metrics" EntityType="hdb.cloud.Metric"/>
        <EntitySet Name="TableAccess" EntityType="hdb.cloud.TableAccessEntry"/>
        <EntitySet Name="Recommendations" EntityType="hdb.cloud.Recommendation"/>
        <EntitySet Name="CalculationViews" EntityType="hdb.cloud.CalculationView"/>
        <EntitySet Name="CV_REVENUE" EntityType="hdb.cloud.CV_REVENUEType"/>
        <EntitySet Name="Bindings" EntityType="hdb.cloud.Binding"/>
        <EntitySet Name="DataProducts" EntityType="hdb.cloud.DataProduct"/>
        <ActionImport Name="RunAdvisors" Action="hdb.cloud.RunAdvisors" EntitySet="Recommendations"/>
        <ActionImport Name="InstallDataProduct" Action="hdb.cloud.InstallDataProduct"/>
        <ActionImport Name="UninstallDataProduct" Action="hdb.cloud.UninstallDataProduct"/>
        <ActionImport Name="ClearTraces" Action="hdb.cloud.ClearTraces"/>
        <FunctionImport Name="IssueSummary" Function="hdb.cloud.IssueSummary" IncludeInServiceDocument="true"/>
        <ActionImport Name="Ask" Action="hdb.cloud.Ask"/>
      </EntityContainer>
      <Annotations Target="hdb.cloud.Container/WorkloadClasses">
        <Annotation Term="Core.Description" String="Workload classes with limits"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/WorkloadMappings">
        <Annotation Term="Core.Description" String="Users and roles mapped to workload classes"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/Traces">
        <Annotation Term="Core.Description" String="SQL trace, expensive statements, errors and workload violations"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/Metrics">
        <Annotation Term="Core.Description" String="Metric samples, one per interval"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/TableAccess">
        <Annotation Term="Core.Description" String="Accesses per table since start"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/Recommendations">
        <Annotation Term="Core.Description" String="Recommendations of the Index, NSE, Partition, Performance Class and ECN advisors"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/CalculationViews">
        <Annotation Term="Core.Description" String="Calculation view definitions"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/CV_REVENUE">
        <Annotation Term="Core.Description" String="Revenue by status"/>
      </Annotations>
      <Annotations Target="hdb.cloud.CV_REVENUEType/ID">
        <Annotation Term="Core.Description" String="Row number"/>
      </Annotations>
      <Annotations Target="hdb.cloud.CV_REVENUEType/STATUS">
        <Annotation Term="Core.Description" String="status"/>
      </Annotations>
      <Annotations Target="hdb.cloud.CV_REVENUEType/REVENUE">
        <Annotation Term="Core.Description" String="sum of amount"/>
      </Annotations>
      <Annotations Target="hdb.cloud.CV_REVENUEType/ORDERS">
        <Annotation Term="Core.Description" String="count of id"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/Bindings">
        <Annotation Term="Core.Description" String="Applications bound to this instance (credentials only via REST at creation)"/>
      </Annotations>
      <Annotations Target="hdb.cloud.Container/DataProducts">
        <Annotation Term="Core.Description" String="Data products shared to this environment"/>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>

