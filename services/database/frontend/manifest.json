{
  "_version": "1.60.0",
  "sap.app": {
    "id": "hdb.client",
    "type": "application",
    "title": "{{appTitle}}",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        "",
        "en",
        "de"
      ],
      "fallbackLocale": ""
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      },
      "cloudService": {
        "uri": "/odata/v4/cloud/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "hdb.client.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "hdb.client.i18n.i18n",
          "supportedLocales": [
            "",
            "en",
            "de"
          ],
          "fallbackLocale": ""
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "async": true
      },
      "routes": [
        {
          "name": "home",
          "pattern": ""
        },
        {
          "name": "backups",
          "pattern": "backups"
        },
        {
          "name": "statistics",
          "pattern": "statistics"
        },
        {
          "name": "help",
          "pattern": "help"
        },
        {
          "name": "instances",
          "pattern": "instances"
        },
        {
          "name": "monitoring",
          "pattern": "monitoring"
        },
        {
          "name": "advisors",
          "pattern": "advisors"
        },
        {
          "name": "workloads",
          "pattern": "workloads"
        },
        {
          "name": "views",
          "pattern": "views"
        },
        {
          "name": "bindings",
          "pattern": "bindings"
        },
        {
          "name": "dataproducts",
          "pattern": "dataproducts"
        },
        {
          "name": "assistant",
          "pattern": "assistant"
        },
        {
          "name": "table",
          "pattern": "tables/{set}"
        },
        {
          "name": "row",
          "pattern": "tables/{set}/rows/{key}"
        }
      ]
    }
  }
}
