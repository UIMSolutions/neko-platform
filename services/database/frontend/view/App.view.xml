<mvc:View controllerName="hdb.client.controller.App" displayBlock="true" height="100%"
	xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:tnt="sap.tnt">
	<App id="shell">
		<Page showHeader="false" enableScrolling="false" busy="{app>/busy}">
			<VBox height="100%" renderType="Bare" visible="{= !${app>/authenticated} }" alignItems="Center" justifyContent="Center">
				<mvc:XMLView id="login" viewName="hdb.client.view.Login" async="true"/>
			</VBox>
			<tnt:ToolPage id="toolPage" visible="{app>/authenticated}">
				<tnt:header>
					<f:ShellBar title="{i18n>appTitle}" secondTitle="{app>/userTenant}" showNavButton="false" showMenuButton="true" menuButtonPressed=".onToggleSideNav" avatarPressed=".onProfile">
						<f:profile>
							<Avatar id="profile" initials="{path: 'app>/user', formatter: '.initials'}"/>
						</f:profile>
					</f:ShellBar>
				</tnt:header>
				<tnt:sideContent>
					<tnt:SideNavigation id="sideNav" ariaLabel="{i18n>navigation}" selectedKey="{app>/navKey}" itemSelect=".onSideNavSelect">
						<tnt:item>
							<tnt:NavigationList>
								<tnt:NavigationListItem key="instances" text="{i18n>instances}" icon="sap-icon://it-instance" visible="{app>/isSystem}"/>
								<tnt:NavigationListItem key="home" text="{i18n>tables}" icon="sap-icon://table-view" visible="{= !${app>/isSystem} }"/>
								<tnt:NavigationListItem key="statistics" text="{i18n>statistics}" icon="sap-icon://vertical-bar-chart" visible="{= !${app>/isSystem} }"/>
								<tnt:NavigationListItem key="backups" text="{i18n>backups}" icon="sap-icon://product" visible="{app>/canBackups}"/>
								<tnt:NavigationListItem key="monitoring" text="{i18n>monitoring}" icon="sap-icon://line-chart" visible="{app>/canMonitor}"/>
								<tnt:NavigationListItem key="advisors" text="{i18n>advisors}" icon="sap-icon://lightbulb" visible="{app>/canMonitor}"/>
								<tnt:NavigationListItem key="workloads" text="{i18n>workloads}" icon="sap-icon://performance" visible="{= ${app>/canMonitor} || ${app>/canWorkloads} }"/>
								<tnt:NavigationListItem key="views" text="{i18n>calcViews}" icon="sap-icon://cube" visible="{= !${app>/isSystem} }"/>
								<tnt:NavigationListItem key="dataproducts" text="{i18n>dataProducts}" icon="sap-icon://database" visible="{= !${app>/isSystem} }"/>
								<tnt:NavigationListItem key="bindings" text="{i18n>bindings}" icon="sap-icon://chain-link" visible="{app>/canBindings}"/>
								<tnt:NavigationListItem key="assistant" text="{i18n>assistant}" icon="sap-icon://da-2"/>
							</tnt:NavigationList>
						</tnt:item>
						<tnt:fixedItem>
							<tnt:NavigationList>
								<tnt:NavigationListItem key="help" text="{i18n>help}" icon="sap-icon://sys-help"/>
								<tnt:NavigationListItem text="{i18n>adminConsole}" icon="sap-icon://action-settings" href="/admin" selectable="false"/>
							</tnt:NavigationList>
						</tnt:fixedItem>
					</tnt:SideNavigation>
				</tnt:sideContent>
				<tnt:mainContents>
					<f:FlexibleColumnLayout id="fcl" layout="{app>/layout}" backgroundDesign="Solid">
						<f:beginColumnPages>
							<mvc:XMLView id="tables" viewName="hdb.client.view.Tables" async="true"/>
						</f:beginColumnPages>
						<f:midColumnPages>
							<mvc:XMLView id="rows" viewName="hdb.client.view.Rows" async="true"/>
							<mvc:XMLView id="backups" viewName="hdb.client.view.Backups" async="true"/>
							<mvc:XMLView id="statistics" viewName="hdb.client.view.Statistics" async="true"/>
							<mvc:XMLView id="help" viewName="hdb.client.view.Help" async="true"/>
							<mvc:XMLView id="instances" viewName="hdb.client.view.Instances" async="true"/>
							<mvc:XMLView id="monitoring" viewName="hdb.client.view.Monitoring" async="true"/>
							<mvc:XMLView id="advisors" viewName="hdb.client.view.Advisors" async="true"/>
							<mvc:XMLView id="workloads" viewName="hdb.client.view.Workloads" async="true"/>
							<mvc:XMLView id="views" viewName="hdb.client.view.CalcViews" async="true"/>
							<mvc:XMLView id="dataproducts" viewName="hdb.client.view.DataProducts" async="true"/>
							<mvc:XMLView id="bindings" viewName="hdb.client.view.Bindings" async="true"/>
							<mvc:XMLView id="assistant" viewName="hdb.client.view.Assistant" async="true"/>
						</f:midColumnPages>
						<f:endColumnPages>
							<mvc:XMLView id="row" viewName="hdb.client.view.Row" async="true"/>
						</f:endColumnPages>
					</f:FlexibleColumnLayout>
				</tnt:mainContents>
			</tnt:ToolPage>
		</Page>
	</App>
</mvc:View>
