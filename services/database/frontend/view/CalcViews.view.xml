<mvc:View controllerName="hdb.client.controller.CalcViews" height="100%" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core">
	<f:DynamicPage toggleHeaderOnTitleClick="false" showFooter="false" busy="{view>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>calcViews}"/></f:heading>
				<f:actions>
					<Button text="{i18n>createView}" type="Emphasized" icon="sap-icon://add" press=".onCreate" visible="{app>/canManageViews}"/>
					<Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" type="Transparent" press=".onRefresh"/>
				</f:actions>
				<f:navigationActions>
					<Button icon="sap-icon://decline" tooltip="{i18n>close}" type="Transparent" press=".onClose"/>
				</f:navigationActions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox>
				<MessageStrip text="{i18n>calcViewsHint}" type="Information" class="sapUiSmallMarginBottom"/>
				<Table id="list" items="{path: 'cloud>/CalculationViews'}" noDataText="{i18n>noViews}" sticky="ColumnHeaders">
					<columns>
						<Column><Text text="{i18n>view}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>attributes}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>measures}"/></Column>
						<Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>odataEntitySet}"/></Column>
						<Column hAlign="End" width="12rem"><Text text=""/></Column>
					</columns>
					<ColumnListItem>
						<ObjectIdentifier title="{cloud>name}" text="{cloud>label} ({cloud>viewType}, {cloud>tables})"/>
						<Text text="{cloud>attributes}"/>
						<Text text="{cloud>measures}"/>
						<Text text="/odata/v4/cloud/{cloud>entitySet}"/>
						<HBox justifyContent="End">
							<Button text="{i18n>preview}" type="Transparent" press=".onPreview"/>
							<Button icon="sap-icon://delete" tooltip="{i18n>delete}" type="Transparent" press=".onDelete" visible="{app>/canManageViews}"/>
						</HBox>
					</ColumnListItem>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
