<mvc:View controllerName="hdb.client.controller.DataProducts" height="100%" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f" xmlns:core="sap.ui.core">
	<f:DynamicPage toggleHeaderOnTitleClick="false" showFooter="false" busy="{view>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>dataProducts}"/></f:heading>
				<f:actions>

					<Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" type="Transparent" press=".onRefresh"/>
				</f:actions>
				<f:navigationActions>
					<Button icon="sap-icon://decline" tooltip="{i18n>close}" type="Transparent" press=".onClose"/>
				</f:navigationActions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox>
				<MessageStrip text="{i18n>dataProductsHint}" type="Information" class="sapUiSmallMarginBottom"/>
				<Table id="list" items="{path: 'cloud>/DataProducts', suspended: true}" noDataText="{i18n>noDataProducts}" sticky="ColumnHeaders">
					<columns>
						<Column><Text text="{i18n>dataProduct}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>provider}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>tablesColumn}"/></Column>
						<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>backupRows}"/></Column>
						<Column hAlign="End" width="12rem"><Text text=""/></Column>
					</columns>
					<ColumnListItem>
						<ObjectIdentifier title="{cloud>title} {cloud>version}" text="{cloud>id} — {cloud>description}"/>
						<Text text="{cloud>provider}"/>
						<Text text="{parts: [{path: 'cloud>installed', targetType: 'any'}, 'cloud>installedTables', 'cloud>tables'], formatter: '.formatter.productTables'}"/>
						<Text text="{cloud>rows}"/>
						<HBox justifyContent="End" visible="{app>/canDataProducts}">
							<Button text="{i18n>install}" type="Emphasized" visible="{= !${cloud>installed} }" press=".onInstall"/>
							<Button text="{i18n>uninstall}" type="Transparent" visible="{cloud>installed}" press=".onUninstall"/>
						</HBox>
					</ColumnListItem>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
