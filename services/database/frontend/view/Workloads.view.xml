<mvc:View controllerName="hdb.client.controller.Workloads" height="100%" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:f="sap.f">
	<f:DynamicPage toggleHeaderOnTitleClick="false" showFooter="false" busy="{view>/busy}">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading><Title text="{i18n>workloads}"/></f:heading>
				<f:actions>
					<Button text="{i18n>createWorkloadClass}" type="Emphasized" icon="sap-icon://add" press=".onCreateClass" visible="{app>/canWorkloads}"/>
					<Button text="{i18n>createMapping}" icon="sap-icon://chain-link" press=".onCreateMapping" visible="{app>/canWorkloads}"/>
					<Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" type="Transparent" press=".onRefresh"/>
				</f:actions>
				<f:navigationActions>
					<Button icon="sap-icon://decline" tooltip="{i18n>close}" type="Transparent" press=".onClose"/>
				</f:navigationActions>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox>
				<MessageStrip text="{i18n>workloadsHint}" type="Information" class="sapUiSmallMarginBottom"/>
				<Title text="{i18n>workloadClasses}" class="sapUiTinyMarginBottom"/>
				<Table id="list" items="{path: 'cloud>/WorkloadClasses', suspended: true}" noDataText="{i18n>noWorkloadClasses}" class="sapUiMediumMarginBottom">
					<columns>
						<Column><Text text="{i18n>name}"/></Column>
						<Column hAlign="End"><Text text="{i18n>priority}"/></Column>
						<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>timeoutSeconds}"/></Column>
						<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>memoryLimitMb}"/></Column>
						<Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>statementLimit}"/></Column>
						<Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>enabled}"/></Column>
						<Column hAlign="End" width="4rem"><Text text=""/></Column>
					</columns>
					<ColumnListItem>
						<Text text="{cloud>name}"/>
						<Text text="{cloud>priority}"/>
						<Text text="{cloud>statementTimeoutSeconds}"/>
						<Text text="{cloud>statementMemoryLimitMb}"/>
						<Text text="{cloud>totalStatementLimit}"/>
						<ObjectStatus text="{parts: [{path: 'cloud>enabled', targetType: 'any'}, 'i18n>yes', 'i18n>no'], formatter: '.formatter.choose'}" state="{path: 'cloud>enabled', targetType: 'any', formatter: '.formatter.enabledState'}"/>
						<Button icon="sap-icon://delete" tooltip="{i18n>delete}" type="Transparent" press=".onDeleteClass" visible="{app>/canWorkloads}"/>
					</ColumnListItem>
				</Table>
				<Title text="{i18n>workloadMappings}" class="sapUiTinyMarginBottom"/>
				<Table id="mappings" items="{path: 'cloud>/WorkloadMappings', suspended: true}" noDataText="{i18n>noMappings}">
					<columns>
						<Column><Text text="{i18n>name}"/></Column>
						<Column><Text text="{i18n>workloadClass}"/></Column>
						<Column><Text text="{i18n>user}"/></Column>
						<Column><Text text="{i18n>role}"/></Column>
						<Column hAlign="End" width="4rem"><Text text=""/></Column>
					</columns>
					<ColumnListItem>
						<Text text="{cloud>name}"/>
						<Text text="{cloud>workloadClass}"/>
						<Text text="{cloud>userName}"/>
						<Text text="{cloud>roleName}"/>
						<Button icon="sap-icon://delete" tooltip="{i18n>delete}" type="Transparent" press=".onDeleteMapping" visible="{app>/canWorkloads}"/>
					</ColumnListItem>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
