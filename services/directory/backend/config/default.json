{
  "serviceName": "Identity Directory Service",
  "host": "0.0.0.0",
  "port": 8082,
  "logLevel": "info",
  "storage": "file",
  "dataDir": "data",
  "defaultTenant": "default",
  "odataPath": "/odata/v4/identity-directory",
  "scimPath": "/scim/v2",
  "housekeepingIntervalSeconds": 60,
  "housekeepingTenants": [
    "default"
  ],
  "seedContent": true,
  "passwordHashIterations": 120000,
  "auditRetentionDays": 365,
  "eventWebhookUrl": "",
  "frontendDir": "../frontend"
}
