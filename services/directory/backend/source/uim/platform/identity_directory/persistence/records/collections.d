module neko.directory.persistence.records.collections;

import neko.directory;

mixin(ShowModule!());

@safe:

/// Technical collection (table) names of the Identity Directory service.
enum DirectoryCollections : string {
  users = "users",
  groups = "groups",
  schemas = "schemas",
  policies = "password_policies",
  apiClients = "api_clients",
  auditEvents = "audit_events",
}

/// Version of the snapshot record layout. Increment on breaking changes.
enum int directoryRecordSchemaVersion = 1;

/// A snapshot file: { "schemaVersion": 1, "collection": "...", "records": [ ... ] }
struct SnapshotEnvelope {
  string collection;
  Json[] records;

  Json toJson() const {
    auto arr = Json.emptyArray;
    foreach (r; records)
      arr ~= r;
    return Json.emptyObject
      .set("schemaVersion", directoryRecordSchemaVersion)
      .set("collection", collection)
      .set("records", arr);
  }

  static SnapshotEnvelope fromJson(string collection, Json json) {
    SnapshotEnvelope env;
    env.collection = collection;
    if (json.type == Json.Type.object && "records" in json && json["records"].type == Json.Type.array)
      foreach (r; json["records"].get!(Json[]))
        env.records ~= r;
    return env;
  }
}
