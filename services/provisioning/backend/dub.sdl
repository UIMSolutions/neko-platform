name "provisioning"
description "Identity Provisioning "
homepage "https://"
authors "Ozan Nurettin Süel" "UI Manufaktur UG (R.I.P :-("
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

license "Apache-2.0"
dependency "vibe-d" version="~>0.10.5"
dependency "dyaml" version="~>0.10.0"
dependency "uim-framework" version="~>26.11.1"
targetType "executable"
targetPath "build"
targetName "neko_service_platform"
authors "Ozan Nurettin Süel"
copyright "Ozan Nurettin Süel"
copyrightYear 2026

mainSourceFile "backend/source/app.d"
sourcePaths "backend/source"
importPaths "backend/source"
stringImportPaths "backend/views"

dependency ":service" version="*"

buildRequirements "allowWarnings" "silenceDeprecations"
buildOptions "ignoreDeprecations" "debugInfo"

// ── HTTP server: REST (/api/v1) + OData v4 (/odata/v4/identity-provisioning) + Fiori app
// dub build            (or --config=defaultRun)
// ./build/uim-identity-provisioning-platform-service
configuration "defaultRun" {
	targetType "executable"
	targetName "uim-identity-provisioning-platform-service"
	mainSourceFile "source/app.d"
	excludedSourceFiles "source/cli.d" "source/gui.d"
}

// ── Command line interface ──────────────────────────────────────────────────
// dub build --config=cli
// ./build/uim-ips-cli help
configuration "cli" {
	targetType "executable"
	targetName "uim-ips-cli"
	mainSourceFile "source/cli.d"
	excludedSourceFiles "source/app.d" "source/gui.d"
}

// ── Desktop GUI (GtkD 3 / GTK 3.24) ─────────────────────────────────────────
// dub build --config=gui
// ./build/uim-ips-gui [--tenant=<id>] [--data-dir=<dir>]
configuration "gui" {
	targetType "executable"
	targetName "uim-ips-gui"
	mainSourceFile "source/gui.d"
	excludedSourceFiles "source/app.d" "source/cli.d"
	dependency "gtk-d" version="~>3.11.0"
}

// ── Libraries / unit tests ──────────────────────────────────────────────────
// dub test --config=defaultTest
configuration "defaultTest" {
	targetType "library"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "modules" {
	targetType "library"
	versions "show_module"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}

configuration "tests" {
	targetType "library"
	versions "show_module" "show_test"
	excludedSourceFiles "source/app.d" "source/cli.d" "source/gui.d"
}
